---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { caseStudies, profile, type CaseStudy } from '../../data/site';
import { galleries } from '../../data/photos';

export function getStaticPaths() {
  return caseStudies.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: CaseStudy;
}

const { project } = Astro.props;
const position = caseStudies.findIndex((item) => item.slug === project.slug);
const next = caseStudies[(position + 1) % caseStudies.length];
const gallery = project.gallery ? galleries[project.gallery] : undefined;
---

<BaseLayout title={project.seoTitle} description={project.summary} type="article">
  <article class="cs shell">
    <a class="text-link" href="/#work">Back to all work</a>

    <header class="cs-hero">
      <span class="label">{project.index} {project.label}</span>
      <h1>{project.title}</h1>
      <p class="cs-summary">{project.summary}</p>
      <dl class="cs-facts">
        <div><dt>Period</dt><dd>{project.period}</dd></div>
        <div><dt>Role</dt><dd>{project.role}</dd></div>
        <div><dt>Stack</dt><dd>{project.stack.join(' · ')}</dd></div>
      </dl>
    </header>

    <dl class="cs-metrics">
      {project.metrics.map((metric) => (
        <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>
      ))}
    </dl>

    <div class="cs-visual"><ProjectVisual type={project.visual} /></div>

    <section class="cs-block">
      <h2>The problem</h2>
      <p>{project.challenge}</p>
    </section>

    <section class="cs-block">
      <h2>What I did</h2>
      <ol>{project.approach.map((step) => <li>{step}</li>)}</ol>
    </section>

    {project.tables?.map((table) => (
      <section class="cs-block">
        <h2>{table.caption}</h2>
        <div class="cs-table-wrap" tabindex="0" role="region" aria-label={table.caption}>
          <table class="cs-table">
            <thead><tr>{table.head.map((cell) => <th scope="col">{cell}</th>)}</tr></thead>
            <tbody>
              {table.rows.map((row, rowIndex) => (
                <tr class={table.highlightLast && rowIndex === table.rows.length - 1 ? 'is-highlight' : undefined}>
                  {row.map((cell, cellIndex) => (cellIndex === 0 ? <th scope="row">{cell}</th> : <td class={/^[~\d]|^n\/a$/.test(cell) ? 'cs-num' : undefined}>{cell}</td>))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {table.note && <p class="cs-note">{table.note}</p>}
      </section>
    ))}

    <section class="cs-block">
      <h2>The result</h2>
      <p>{project.result}</p>
      {project.external && (
        <p class="cs-links">
          {project.external.map((link) => (
            <a class="btn btn-ghost" href={link.href} target="_blank" rel="noreferrer">{link.label} <Icon name="arrow-up-right" size={16} /></a>
          ))}
        </p>
      )}
    </section>

    {gallery && (
      <section class="cs-block">
        <h2>{gallery.title}</h2>
        <p>{gallery.intro}</p>
        <div class="jrow cs-gallery">
          {gallery.photos.map((photo) => (
            <Photo photo={photo} group={`gallery-${project.slug}`} sizes="(max-width: 980px) 92vw, 600px" widths={[480, 720, 960, 1280]} />
          ))}
        </div>
      </section>
    )}

    <hr class="tear" />
    <nav class="cs-next" aria-label="Next case study">
      <span class="label">Next case study</span>
      <a href={`/work/${next.slug}`}>{next.title}</a>
      <a class="text-link" href={profile.resume} target="_blank" rel="noopener noreferrer">Résumé (PDF) <Icon name="download" size={15} /></a>
    </nav>
  </article>
</BaseLayout>

<style>
  .cs {
    max-width: 920px;
    padding-block: clamp(20px, 4vw, 44px) 72px;
  }
  .cs-hero {
    margin-top: 20px;
  }
  .cs-hero h1 {
    margin-top: 14px;
    font-size: clamp(2.1rem, 5.4vw, 3.8rem);
  }
  .cs-summary {
    max-width: 62ch;
    margin-top: 20px;
    color: var(--muted);
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
  }
  .cs-facts {
    display: grid;
    gap: 16px 24px;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid var(--line-strong);
  }
  .cs-facts dt,
  .cs-metrics dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .cs-facts dd {
    margin-top: 4px;
  }
  .cs-metrics {
    display: grid;
    margin-top: 30px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-l);
  }
  .cs-metrics > div {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    border-bottom: 1px dashed var(--line-strong);
  }
  .cs-metrics > div:last-child {
    border-bottom: 0;
  }
  .cs-metrics dd {
    order: -1;
    color: var(--green);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .cs-visual {
    display: grid;
    min-height: 340px;
    margin-top: 30px;
    padding: clamp(22px, 5vw, 48px);
    background: var(--paper-deep);
    border-radius: var(--radius-l);
  }
  .cs-block {
    margin-top: 52px;
  }
  .cs-block h2 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }
  .cs-block p,
  .cs-block li {
    max-width: 68ch;
    margin-top: 14px;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .cs-block ol {
    padding-left: 1.3em;
    list-style: decimal;
  }
  .cs-block li::marker {
    color: var(--green);
    font-weight: 700;
  }
  .cs-table-wrap {
    margin-top: 18px;
    overflow-x: auto;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
  }
  .cs-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .cs-table th,
  .cs-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .cs-table thead th {
    color: var(--muted);
    background: var(--paper-deep);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 400;
  }
  .cs-table tbody th {
    font-weight: 650;
  }
  .cs-table td.cs-num {
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .cs-table tr:last-child th,
  .cs-table tr:last-child td {
    border-bottom: 0;
  }
  .cs-table tr.is-highlight th,
  .cs-table tr.is-highlight td {
    color: var(--green);
    font-weight: 700;
  }
  .cs-block .cs-note {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .cs-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cs-gallery {
    margin-top: 22px;
  }
  .cs > .tear {
    margin-top: 64px;
  }
  .cs-next {
    display: grid;
    justify-items: start;
    gap: 10px;
    padding-top: 26px;
  }
  .cs-next > a:not(.text-link) {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .cs-next > a:not(.text-link):hover {
    color: var(--green);
  }
  .cs-next > a:not(.text-link):active {
    opacity: 0.75;
  }
  @media (min-width: 720px) {
    .cs-facts {
      grid-template-columns: 1fr 1fr 1.4fr;
    }
    .cs-metrics {
      grid-template-columns: repeat(3, 1fr);
    }
    .cs-metrics > div {
      border-bottom: 0;
      border-left: 1px dashed var(--line-strong);
    }
    .cs-metrics > div:first-child {
      border-left: 0;
    }
    .cs-visual {
      min-height: 420px;
    }
  }
</style>
