---
import Base from '../../layouts/Base.astro';
import CaseVisual from '../../components/CaseVisual.astro';
import Icon from '../../components/Icon.astro';
import PhotoLink from '../../components/PhotoLink.astro';
import { galleries } from '../../data/photos';
import { caseStudies, profile, type CaseStudy } from '../../data/site';

export function getStaticPaths() {
  return caseStudies.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: CaseStudy;
}

const { project } = Astro.props;
const position = caseStudies.findIndex((item) => item.slug === project.slug);
const next = caseStudies[(position + 1) % caseStudies.length];
const gallery = project.gallery ? galleries[project.gallery] : undefined;
// Cells that hold a measurement are set in monospace and right-aligned.
const isNumber = (cell: string) => /^[~\d]|^n\/a$/.test(cell);
// A column header is right-aligned only when every cell under it is a measurement.
const numericColumn = (rows: string[][], c: number) => c > 0 && rows.every((row) => isNumber(row[c] ?? ''));
---

<Base title={project.seoTitle} description={project.summary} type="article">
  <header class="cs-hero">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a class="back" href="/#work"><Icon name="arrow-left" size={18} /> All case studies</a>
      </nav>
      <p class="eyebrow"><b>{project.index}</b> {project.label}</p>
      <h1>{project.title}</h1>
      <p class="cs-summary">{project.summary}</p>
      <dl class="card cs-facts">
        <div><dt class="label">Period</dt><dd>{project.period}</dd></div>
        <div><dt class="label">Role</dt><dd>{project.role}</dd></div>
        <div><dt class="label">Stack</dt><dd><ul class="tags">{project.stack.map((item) => <li>{item}</li>)}</ul></dd></div>
      </dl>
    </div>
  </header>

  <div class="shell cs">
    <dl class="cs-metrics" data-stagger>
      {project.metrics.map((metric) => (
        <div class="card">
          <dt>{metric.label}</dt>
          <dd class="num">{metric.value}</dd>
        </div>
      ))}
    </dl>

    <div class="card cs-ev">
      <CaseVisual type={project.visual} large />
    </div>

    <div class="cs-body">
      <section class="cs-block" aria-labelledby="problem">
        <h2 id="problem">The problem</h2>
        <p class="cs-lead">{project.challenge}</p>
      </section>

      <section class="cs-block" aria-labelledby="approach">
        <h2 id="approach">What I did</h2>
        <ol class="cs-steps">
          {project.approach.map((step, i) => (
            <li class="card"><span class="step-num num" aria-hidden="true">{i + 1}</span><p>{step}</p></li>
          ))}
        </ol>
      </section>

      {project.tables?.map((table, t) => (
        <section class="cs-block" aria-labelledby={`table-${t}`}>
          <h2 id={`table-${t}`}>{table.caption}</h2>
          <div class="table-wrap" tabindex="0" role="region" aria-label={`${table.caption} (scrolls sideways)`}>
            <table>
              <thead>
                <tr>{table.head.map((cell, c) => <th scope="col" class:list={{ num: numericColumn(table.rows, c) }}>{cell || <span class="sr-only">Item</span>}</th>)}</tr>
              </thead>
              <tbody>
                {table.rows.map((row, r) => (
                  <tr class:list={{ chosen: table.highlightLast && r === table.rows.length - 1 }}>
                    {row.map((cell, c) => (c === 0 ? <th scope="row">{cell}</th> : <td class:list={{ num: isNumber(cell) }}>{cell}</td>))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {table.note && <p class="label cs-note">{table.note}</p>}
        </section>
      ))}

      <section class="cs-block" aria-labelledby="result">
        <h2 id="result">The result</h2>
        <p class="cs-lead">{project.result}</p>
        {project.external && project.external.length > 0 && (
          <ul class="cs-links">
            {project.external.map((link) => (
              <li><a class="btn btn-secondary" href={link.href} target="_blank" rel="noopener">{link.label} <Icon name="out" size={17} /></a></li>
            ))}
          </ul>
        )}
      </section>

      {gallery && gallery.photos.length > 0 && (
        <section class="cs-block" aria-labelledby="gallery">
          <h2 id="gallery">{gallery.title}</h2>
          <p class="muted">{gallery.intro}</p>
          <div class="cs-gallery">
            {gallery.photos.map((photo) => (
              <PhotoLink photo={photo} group={`gallery-${project.slug}`} sizes="(max-width: 760px) 92vw, 440px" widths={[480, 720, 960]} />
            ))}
          </div>
        </section>
      )}
    </div>
  </div>

  <nav class="shell cs-next-wrap" aria-label="Next case study">
    <div class="card card-hover cs-next">
      <p class="eyebrow"><b>{next.index}</b> Next case study</p>
      <a class="next-link stretch" href={`/work/${next.slug}`}>{next.title}</a>
      <span class="next-more" aria-hidden="true">{next.label} <Icon name="arrow-right" size={18} /></span>
    </div>
    <a class="text-link" href={profile.resume} target="_blank" rel="noopener">Download résumé (PDF) <Icon name="download" size={16} /></a>
  </nav>
</Base>

<style>
  .muted {
    color: var(--color-muted-foreground);
  }
  .cs-hero {
    padding-block: 16px clamp(40px, 6vw, 64px);
    background: radial-gradient(60% 60% at 90% 0%, color-mix(in srgb, var(--color-secondary) 14%, transparent), transparent 70%);
  }
  :global([data-theme='dark']) .cs-hero {
    background: none;
  }
  .cs-hero .shell {
    display: grid;
    justify-items: start;
    gap: 20px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding-inline: 14px 18px;
    margin-bottom: 8px;
    color: var(--color-foreground);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: 600;
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease;
  }
  .back:hover {
    background: var(--color-primary-soft);
    border-color: var(--color-primary);
  }
  .cs-hero h1 {
    max-width: 20ch;
    font-size: clamp(2.2rem, 5.4vw, 4rem);
  }
  .cs-summary {
    max-width: 62ch;
    color: var(--color-muted-foreground);
    font-size: clamp(1.08rem, 1.5vw, 1.2rem);
  }
  .cs-facts {
    display: grid;
    width: 100%;
    gap: 18px 32px;
    margin-top: 12px;
  }
  .cs-facts dd {
    margin-top: 6px;
    font-family: var(--font-heading);
    font-weight: 600;
  }
  @media (min-width: 860px) {
    .cs-facts {
      grid-template-columns: 0.7fr 1fr 1.6fr;
    }
  }

  .cs {
    padding-bottom: clamp(48px, 7vw, 80px);
  }
  .cs-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
  }
  .cs-metrics .card {
    display: grid;
    gap: 6px;
    padding: 20px 24px;
  }
  .cs-metrics dt {
    color: var(--color-muted-foreground);
  }
  .cs-metrics dd {
    order: -1;
    color: var(--color-primary);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .cs-ev {
    display: grid;
    margin-block: clamp(24px, 4vw, 40px) clamp(48px, 7vw, 80px);
    padding: clamp(20px, 5vw, 56px);
    container-type: inline-size;
  }

  .cs-body {
    display: grid;
    max-width: 820px;
    gap: clamp(48px, 7vw, 72px);
  }
  .cs-block {
    display: grid;
    gap: 20px;
  }
  .cs-block h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.4rem);
  }
  .cs-lead {
    font-size: clamp(1.1rem, 1.7vw, 1.25rem);
    line-height: 1.6;
  }
  .cs-steps {
    display: grid;
    gap: 12px;
  }
  .cs-steps li {
    display: grid;
    grid-template-columns: 40px 1fr;
    align-items: start;
    gap: 16px;
    padding: 20px;
  }
  .step-num {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-radius: var(--radius-full);
    font-weight: 700;
  }
  .cs-steps p {
    padding-top: 6px;
  }

  .table-wrap {
    overflow-x: auto;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  table {
    width: 100%;
    min-width: 560px;
    font-size: 0.98rem;
  }
  th,
  td {
    padding: 14px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-border);
  }
  thead th {
    white-space: nowrap;
    color: var(--color-muted-foreground);
    background: var(--color-muted);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
  }
  tbody th {
    font-weight: 600;
  }
  td.num {
    text-align: right;
    white-space: nowrap;
  }
  thead th.num {
    text-align: right;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  tr.chosen > * {
    background: var(--color-primary-soft);
  }
  tr.chosen td.num {
    color: var(--color-primary);
    font-weight: 700;
  }

  .cs-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cs-gallery {
    display: grid;
    gap: 12px;
  }
  .cs-gallery > :global(.photo-link) {
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 640px) {
    .cs-gallery {
      grid-template-columns: 1fr 1fr;
    }
    .cs-gallery > :global(.photo-link) {
      aspect-ratio: 3 / 4;
    }
  }

  .cs-next-wrap {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding-bottom: clamp(56px, 8vw, 96px);
  }
  .cs-next {
    display: grid;
    width: 100%;
    gap: 14px;
    padding: clamp(24px, 4vw, 40px);
    cursor: pointer;
  }
  .next-link {
    max-width: 26ch;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
  }
  .next-link:focus-visible {
    outline: none;
  }
  .cs-next:has(a:focus-visible) {
    outline: 3px solid var(--color-ring);
    outline-offset: 3px;
  }
  .next-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 600;
  }
  .next-more :global(.icon) {
    transition: transform var(--duration) ease;
  }
  .cs-next:hover .next-more :global(.icon) {
    transform: translateX(4px);
  }
</style>
