---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { caseStudies, profile, type CaseStudy } from '../../data/site';
import { galleries } from '../../data/photos';

export function getStaticPaths() {
  return caseStudies.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: CaseStudy;
}

const { project } = Astro.props;
const position = caseStudies.findIndex((item) => item.slug === project.slug);
const next = caseStudies[(position + 1) % caseStudies.length];
const gallery = project.gallery ? galleries[project.gallery] : undefined;
---

<BaseLayout title={project.seoTitle} description={project.summary} type="article">
  <article class={`cs shell accent-${project.accent}`}>
    <a class="cs-back" href="/#work"><Icon name="arrow-right" size={15} /> All work</a>

    <header class="cs-hero">
      <span class="section-kicker">{project.index} / {project.label}</span>
      <h1>{project.title}</h1>
      <p class="cs-summary">{project.summary}</p>
      <dl class="cs-facts">
        <div><dt>Period</dt><dd>{project.period}</dd></div>
        <div><dt>Role</dt><dd>{project.role}</dd></div>
        <div><dt>Stack</dt><dd>{project.stack.join(' · ')}</dd></div>
      </dl>
    </header>

    <div class="cs-metrics">
      {project.metrics.map((metric) => (
        <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
      ))}
    </div>

    <div class="cs-visual"><ProjectVisual type={project.visual} /></div>

    <section class="cs-block">
      <h2>The problem</h2>
      <p>{project.challenge}</p>
    </section>

    <section class="cs-block">
      <h2>What I did</h2>
      <ol>{project.approach.map((step) => <li>{step}</li>)}</ol>
    </section>

    {project.tables?.map((table) => (
      <section class="cs-block">
        <h2>{table.caption}</h2>
        <div class="cs-table-wrap">
          <table class="cs-table">
            <thead><tr>{table.head.map((cell) => <th scope="col">{cell}</th>)}</tr></thead>
            <tbody>
              {table.rows.map((row, rowIndex) => (
                <tr class={table.highlightLast && rowIndex === table.rows.length - 1 ? 'is-highlight' : undefined}>
                  {row.map((cell, cellIndex) => (cellIndex === 0 ? <th scope="row">{cell}</th> : <td class={/^[~\d—]/.test(cell) ? 'cs-num' : undefined}>{cell}</td>))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {table.note && <p class="cs-note">{table.note}</p>}
      </section>
    ))}

    <section class="cs-block">
      <h2>The result</h2>
      <p>{project.result}</p>
      {project.external && (
        <p class="cs-links">
          {project.external.map((link) => (
            <a class="button button-ghost" href={link.href} target="_blank" rel="noreferrer">{link.label} <Icon name="arrow-up-right" size={16} /></a>
          ))}
        </p>
      )}
    </section>

    {gallery && (
      <section class="cs-block">
        <h2>{gallery.title}</h2>
        <p>{gallery.intro}</p>
        <div class="jrow cs-gallery">
          {gallery.photos.map((photo) => (
            <Photo photo={photo} group={`gallery-${project.slug}`} sizes="(max-width: 980px) 92vw, 600px" widths={[480, 720, 960, 1280]} />
          ))}
        </div>
      </section>
    )}

    <nav class="cs-next" aria-label="Next case study">
      <span>Next case study</span>
      <a href={`/work/${next.slug}`}>{next.title} <Icon name="arrow-right" size={18} /></a>
      <a class="text-link" href={profile.resume} target="_blank" rel="noopener noreferrer">Résumé (PDF) <Icon name="download" size={15} /></a>
    </nav>
  </article>
</BaseLayout>

<style>
  .cs { --accent: var(--violet); padding-block: clamp(110px, 14vw, 160px) 80px; max-width: 980px; }
  .cs.accent-orange { --accent: var(--orange); }
  .cs.accent-teal { --accent: var(--teal); }
  .cs-back { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: .78rem; font-weight: 700; }
  .cs-back :global(svg) { transform: rotate(180deg); }
  .cs-hero { margin-top: 28px; }
  .cs-hero h1 { margin-top: 18px; font-family: var(--font-serif); font-size: clamp(2.2rem, 5.4vw, 4.4rem); font-weight: 500; line-height: 1.02; letter-spacing: -.035em; }
  .cs-summary { max-width: 720px; margin-top: 22px; color: var(--muted); font-size: clamp(1rem, 1.6vw, 1.15rem); line-height: 1.6; }
  .cs-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 34px; padding-top: 22px; border-top: 1px solid var(--line); }
  .cs-facts dt { color: var(--muted); font-size: .62rem; font-weight: 780; letter-spacing: .11em; text-transform: uppercase; }
  .cs-facts dd { margin: 6px 0 0; font-size: .86rem; line-height: 1.5; }
  .cs-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 34px; }
  .cs-metrics div { padding: 22px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--paper-light); }
  .cs-metrics strong { display: block; color: var(--accent); font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 500; line-height: 1; }
  .cs-metrics span { display: block; margin-top: 10px; color: var(--muted); font-size: .78rem; }
  .cs-visual { margin-top: 34px; padding: clamp(14px, 3vw, 30px); border-radius: var(--radius); background: color-mix(in srgb, var(--accent) 11%, var(--paper-deep)); }
  .cs-visual :global(.project-visual) { min-height: 460px; }
  .cs-visual :global(.visual-screens) { min-height: 580px; }
  .cs-block { margin-top: 56px; }
  .cs-block h2 { font-family: var(--font-serif); font-size: clamp(1.5rem, 2.8vw, 2.1rem); font-weight: 500; letter-spacing: -.02em; }
  .cs-block p, .cs-block li { max-width: 760px; margin-top: 14px; font-size: 1rem; line-height: 1.7; }
  .cs-block ol { margin: 6px 0 0; padding-left: 1.3em; list-style: decimal; }
  .cs-block li::marker { color: var(--accent); font-weight: 800; }
  .cs-table-wrap { margin-top: 18px; overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .cs-table { width: 100%; min-width: 560px; border-collapse: collapse; font-size: .86rem; }
  .cs-table th, .cs-table td { padding: 12px 16px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .cs-table thead th { color: var(--muted); font-size: .64rem; font-weight: 780; letter-spacing: .1em; text-transform: uppercase; background: var(--paper-deep); }
  .cs-table tbody th { font-weight: 650; }
  .cs-table td.cs-num { white-space: nowrap; }
  .cs-table tr:last-child th, .cs-table tr:last-child td { border-bottom: 0; }
  .cs-table tr.is-highlight { background: color-mix(in srgb, var(--accent) 9%, transparent); }
  .cs-table tr.is-highlight th, .cs-table tr.is-highlight td { font-weight: 750; }
  .cs-note { color: var(--muted); font-size: .82rem !important; }
  .cs-links { display: flex; flex-wrap: wrap; gap: 12px; }
  .cs-gallery { margin-top: 22px; }
  .cs-next { display: grid; gap: 14px; margin-top: 72px; padding-top: 30px; border-top: 1px solid var(--line); }
  .cs-next > span { color: var(--muted); font-size: .62rem; font-weight: 780; letter-spacing: .11em; text-transform: uppercase; }
  .cs-next > a:not(.text-link) { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-serif); font-size: clamp(1.4rem, 3vw, 2.2rem); line-height: 1.15; }
  @media (max-width: 720px) {
    .cs-facts, .cs-metrics { grid-template-columns: 1fr; }
    .cs-visual :global(.project-visual) { min-height: 400px; }
  }
</style>
