---
import Base from '../../layouts/Base.astro';
import CaseVisual from '../../components/CaseVisual.astro';
import Icon from '../../components/Icon.astro';
import PhotoLink from '../../components/PhotoLink.astro';
import { galleries } from '../../data/photos';
import { caseStudies, profile, type CaseStudy } from '../../data/site';

export function getStaticPaths() {
  return caseStudies.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: CaseStudy;
}

const { project } = Astro.props;
const position = caseStudies.findIndex((item) => item.slug === project.slug);
const next = caseStudies[(position + 1) % caseStudies.length];
const gallery = project.gallery ? galleries[project.gallery] : undefined;
// Cells that hold a measurement are set in monospace and right-aligned.
const isNumber = (cell: string) => /^[~\d]|^n\/a$/.test(cell);
---

<Base title={project.seoTitle} description={project.summary} type="article">
  <header class="cs-hero on-canopy">
    <div class="shell">
      <a class="back" href="/#work"><Icon name="prev" size={18} /> All case studies</a>
      <p class="index"><b>{project.index}</b> {project.label}</p>
      <h1>{project.title}</h1>
      <p class="cs-summary">{project.summary}</p>
      <dl class="cs-facts">
        <div><dt class="mono">Period</dt><dd>{project.period}</dd></div>
        <div><dt class="mono">Role</dt><dd>{project.role}</dd></div>
        <div><dt class="mono">Stack</dt><dd>{project.stack.join(' · ')}</dd></div>
      </dl>
    </div>
  </header>

  <div class="shell cs">
    <dl class="cs-metrics">
      {project.metrics.map((metric) => (
        <div>
          <dt>{metric.label}</dt>
          <dd>{metric.value}</dd>
        </div>
      ))}
    </dl>

    <div class="cs-ev">
      <CaseVisual type={project.visual} large />
    </div>

    <div class="cs-body">
      <section class="cs-block" aria-labelledby="problem">
        <h2 id="problem">The problem</h2>
        <p class="cs-lead">{project.challenge}</p>
      </section>

      <section class="cs-block" aria-labelledby="approach">
        <h2 id="approach">What I did</h2>
        <ol class="cs-steps">
          {project.approach.map((step, i) => (
            <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><p>{step}</p></li>
          ))}
        </ol>
      </section>

      {project.tables?.map((table, t) => (
        <section class="cs-block" aria-labelledby={`table-${t}`}>
          <h2 id={`table-${t}`}>{table.caption}</h2>
          <div class="table-wrap" tabindex="0" role="region" aria-label={`${table.caption} (scrolls sideways)`}>
            <table>
              <thead>
                <tr>{table.head.map((cell) => <th scope="col">{cell || <span class="sr-only">Item</span>}</th>)}</tr>
              </thead>
              <tbody>
                {table.rows.map((row, r) => (
                  <tr class:list={{ chosen: table.highlightLast && r === table.rows.length - 1 }}>
                    {row.map((cell, c) => (c === 0 ? <th scope="row">{cell}</th> : <td class:list={{ num: isNumber(cell) }}>{cell}</td>))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {table.note && <p class="mono cs-note">{table.note}</p>}
        </section>
      ))}

      <section class="cs-block" aria-labelledby="result">
        <h2 id="result">The result</h2>
        <p class="cs-lead">{project.result}</p>
        {project.external && project.external.length > 0 && (
          <ul class="cs-links">
            {project.external.map((link) => (
              <li><a class="btn btn-line" href={link.href} target="_blank" rel="noopener">{link.label} <Icon name="out" size={17} /></a></li>
            ))}
          </ul>
        )}
      </section>

      {gallery && gallery.photos.length > 0 && (
        <section class="cs-block" aria-labelledby="gallery">
          <h2 id="gallery">{gallery.title}</h2>
          <p>{gallery.intro}</p>
          <div class="cs-gallery">
            {gallery.photos.map((photo) => (
              <PhotoLink photo={photo} group={`gallery-${project.slug}`} sizes="(max-width: 760px) 92vw, 440px" widths={[480, 720, 960]} />
            ))}
          </div>
        </section>
      )}
    </div>
  </div>

  <nav class="cs-next on-canopy" aria-label="Next case study">
    <div class="shell">
      <p class="index"><b>Next</b> {next.index} {next.label}</p>
      <a class="next-link" href={`/work/${next.slug}`}>{next.title}</a>
      <a class="text-link" href={profile.resume} target="_blank" rel="noopener">Download résumé (PDF) <Icon name="download" size={16} /></a>
    </div>
  </nav>
</Base>

<style>
  .cs-hero {
    padding-block: 24px clamp(56px, 8vw, 96px);
  }
  .cs-hero .shell {
    display: grid;
    justify-items: start;
    gap: 22px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-bottom: 12px;
    color: var(--on-canopy-muted);
    font-weight: 600;
  }
  .back:hover {
    color: var(--on-canopy);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .cs-hero h1 {
    max-width: 18ch;
    font-size: clamp(2.6rem, 7vw, 5.6rem);
  }
  .cs-summary {
    max-width: 62ch;
    color: var(--on-canopy-muted);
    font-size: clamp(1.08rem, 1.5vw, 1.22rem);
  }
  .cs-facts {
    display: grid;
    width: 100%;
    gap: 18px 32px;
    margin-top: 16px;
    padding-top: 22px;
    border-top: 1px solid var(--canopy-line);
  }
  .cs-facts dt {
    color: var(--on-canopy-muted);
  }
  .cs-facts dd {
    margin-top: 4px;
    font-weight: 550;
  }
  @media (min-width: 860px) {
    .cs-facts {
      grid-template-columns: 0.7fr 1.1fr 1.4fr;
    }
  }

  .cs {
    padding-bottom: clamp(72px, 10vw, 120px);
  }
  .cs-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    border-bottom: 1px solid var(--line-strong);
  }
  .cs-metrics div {
    display: grid;
    gap: 4px;
    padding: 26px 20px 26px 0;
  }
  .cs-metrics dt {
    color: var(--muted);
  }
  .cs-metrics dd {
    order: -1;
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-stretch: 75%;
    font-weight: 800;
    line-height: 1;
  }

  .cs-ev {
    margin-block: clamp(40px, 6vw, 64px);
    padding: clamp(20px, 5vw, 56px);
    background: var(--panel);
    border-radius: var(--radius-l);
  }

  .cs-body {
    display: grid;
    max-width: 820px;
    gap: clamp(48px, 7vw, 80px);
  }
  .cs-block {
    display: grid;
    gap: 20px;
  }
  .cs-block h2 {
    font-size: clamp(2rem, 4.4vw, 3rem);
  }
  .cs-lead {
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    line-height: 1.55;
  }
  .cs-steps li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 14px;
    padding-block: 18px;
    border-top: 1px solid var(--line-strong);
  }
  .cs-steps li:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .cs-steps .mono {
    padding-top: 4px;
    color: var(--muted);
  }

  .table-wrap {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  table {
    width: 100%;
    min-width: 560px;
    font-size: 0.98rem;
  }
  th,
  td {
    padding: 14px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  thead th {
    white-space: nowrap;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 400;
  }
  tbody th {
    font-weight: 600;
  }
  td.num {
    font-family: var(--font-mono);
    text-align: right;
    white-space: nowrap;
  }
  thead th:not(:first-child) {
    text-align: right;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  /* The shipped model's row: a leaf tint, not the accent */
  tr.chosen > * {
    background: color-mix(in srgb, var(--leaf) 12%, transparent);
  }
  tr.chosen td.num {
    color: var(--leaf);
    font-weight: 500;
  }
  .cs-note {
    color: var(--muted);
  }

  .cs-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cs-gallery {
    display: grid;
    gap: 12px;
  }
  .cs-gallery > :global(.photo-link) {
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 640px) {
    .cs-gallery {
      grid-template-columns: 1fr 1fr;
    }
    .cs-gallery > :global(.photo-link) {
      aspect-ratio: 3 / 4;
    }
  }

  .cs-next {
    padding-block: clamp(56px, 8vw, 96px);
  }
  .cs-next .shell {
    display: grid;
    justify-items: start;
    gap: 18px;
  }
  .next-link {
    max-width: 22ch;
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-stretch: 78%;
    font-weight: 800;
    line-height: 1;
    text-wrap: balance;
    text-decoration: underline;
    text-decoration-color: rgba(238, 242, 234, 0.35);
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.14em;
  }
  .next-link:hover {
    text-decoration-color: var(--fruit);
  }
  .next-link:active {
    opacity: 0.8;
  }
</style>
