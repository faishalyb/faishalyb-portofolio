---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import InferenceDemo from '../components/InferenceDemo.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import Photo from '../components/Photo.astro';
import { Image } from 'astro:assets';
import { avatar, logos, portrait, researchPhotos, classPhoto, defensePhotos, weddingPhotos } from '../data/photos';
import {
  profile,
  proofPoints,
  caseStudies,
  experience,
  expertise,
  articles,
  education,
  socialLinks,
  pageCopy,
  writingArchiveUrl,
  spotlight,
  otherProjects,
  wedding,
} from '../data/site';

const title = pageCopy.seoTitle;
const description = pageCopy.seoDescription;
---

<BaseLayout title={title} description={description}>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow-row">
        <span class="eyebrow"><i></i> {pageCopy.heroEyebrow}</span>
        <span class="hero-location">{pageCopy.heroLocation}</span>
      </div>

      <h1 id="hero-title">
        {pageCopy.heroLead}<br />
        <span>{pageCopy.heroMiddle}</span>
        <em>{pageCopy.heroAccent}</em>
      </h1>

      <div class="hero-bottom">
        <p>
          {pageCopy.heroSummary}
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore my work <Icon name="arrow-right" size={17} /></a>
          <a class="button button-ghost" href={profile.resume} target="_blank" rel="noopener noreferrer">Résumé <Icon name="download" size={17} /></a>
        </div>
      </div>
    </div>

    <div class="hero-demo-wrap">
      <div class="hero-stamp" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <defs><path id="stamp-path" d="M50,50 m-35,0 a35,35 0 1,1 70,0 a35,35 0 1,1 -70,0" /></defs>
          <text><textPath href="#stamp-path" textLength="216" lengthAdjust="spacing">FLUTTER · ON-DEVICE ML · OFFLINE FIRST · </textPath></text>
        </svg>
        <span><Image src={avatar.src} alt="" width={200} height={200} class="stamp-photo" priority /></span>
      </div>
      <InferenceDemo />
    </div>
  </section>

  <section class="proof-bar" aria-label="Selected engineering outcomes">
    <div class="proof-track">
      {[false, true].map((isClone) => (
        <div class="proof-group" aria-hidden={isClone ? 'true' : undefined}>
          {proofPoints.map((proof) => (
            <div class="proof-item">
              <strong>{proof.value}</strong>
              <span>{proof.label}</span>
              <i aria-hidden="true"></i>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="section work-section shell" id="work" aria-labelledby="work-title">
    <div class="section-intro" data-reveal>
      <div>
        <span class="section-kicker">01 / Selected work</span>
        <h2 id="work-title">Field apps<br />with <em>receipts.</em></h2>
      </div>
      <p>{pageCopy.workIntro}</p>
    </div>

    <div class="work-list">
      {caseStudies.map((project) => (
        <article class={`work-card accent-${project.accent}`} data-reveal>
          <a class="work-card-link" href={`/work/${project.slug}`}><span class="sr-only">Read the case study: {project.title}</span></a>
          <div class="work-copy">
            <div class="work-meta">
              <span>{project.index}</span>
              <span>{project.label}</span>
            </div>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <div class="work-tags">
              {project.stack.slice(0, 4).map((item) => <span>{item}</span>)}
            </div>
            <div class="work-outcome">
              <small>Outcome</small>
              <strong>{project.outcome}</strong>
            </div>
            <span class="work-link">Read the case study <Icon name="arrow-up-right" size={18} /></span>
          </div>
          <div class="work-visual-wrap">
            <ProjectVisual type={project.visual} />
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section expertise-section shell" aria-labelledby="expertise-title">
    <div class="section-intro compact" data-reveal>
      <div>
        <span class="section-kicker">02 / What I do</span>
        <h2 id="expertise-title">Built for the field,<br /><em>end to end.</em></h2>
      </div>
      <p>{pageCopy.expertiseIntro}</p>
    </div>

    <div class="expertise-grid">
      {expertise.map((item) => (
        <article class="expertise-card" data-reveal>
          <span class="expertise-number">{item.number}</span>
          <div class="expertise-icon" aria-hidden="true"><i></i><i></i><i></i></div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <div class="tool-cloud">{item.tools.map((tool) => <span>{tool}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="section journey-section" id="about" aria-labelledby="journey-title">
    <div class="shell journey-grid">
      <div class="journey-heading" data-reveal>
        <span class="section-kicker">03 / The journey</span>
        <h2 id="journey-title">From the research lab<br />to the <em>plantation field.</em></h2>
        <p>{pageCopy.journeyIntro}</p>
        <a class="text-link" href={profile.resume} target="_blank" rel="noopener noreferrer">The full résumé <Icon name="arrow-up-right" size={16} /></a>
        <a class="text-link" href={profile.portfolioPdf} target="_blank" rel="noopener noreferrer">Portfolio PDF <Icon name="arrow-up-right" size={16} /></a>
      </div>

      <div class="timeline">
        {experience.map((item, index) => (
          <article class="timeline-item" data-reveal>
            <div class="timeline-marker" aria-hidden="true">
              {item.logo ? <Image class="marker-logo" src={logos[item.logo]} alt="" width={116} height={116} /> : <strong>{item.marker}</strong>}
              <span>0{index + 1}</span>
            </div>
            <div class="timeline-copy">
              <div class="timeline-company"><h3>{item.company}</h3><span>{item.location}</span></div>
              {item.roles.map((role) => (
                <div class="timeline-role"><strong>{role.title}</strong><span>{role.dates}</span></div>
              ))}
              <p>{item.note}</p>
              {item.gallery === 'research' && (
                <div class="jrow timeline-photos">
                  <Photo photo={researchPhotos[0]} group="research" sizes="(max-width: 960px) 30vw, 180px" widths={[320, 480, 640]} />
                  <Photo photo={researchPhotos[1]} group="research" count={researchPhotos.length} sizes="(max-width: 960px) 62vw, 400px" widths={[480, 640, 960, 1280]} />
                  {researchPhotos.slice(2).map((photo) => <Photo photo={photo} group="research" viewerOnly />)}
                </div>
              )}
              {item.link && (
                <a class="text-link timeline-link" href={item.link.href} target="_blank" rel="noopener noreferrer">{item.link.label} <Icon name="arrow-up-right" size={15} /></a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section writing-section shell" id="writing" aria-labelledby="writing-title">
    <div class="section-intro writing-intro" data-reveal>
      <div>
        <span class="section-kicker">{pageCopy.writingKicker}</span>
        <h2 id="writing-title">Research,<br /><em>published.</em></h2>
      </div>
      <div class="writing-note">
        <span class="partner-badge"><Icon name="check" size={17} /> Publications</span>
        <p>{pageCopy.writingIntro}</p>
      </div>
    </div>

    <div class="article-grid">
      {articles.map((article, index) => (
        <article class={`article-card article-${index + 1}`} data-reveal>
          <a href={article.href} target="_blank" rel="noopener noreferrer">
            <span class="sr-only">Read {article.title} on {article.source}</span>
          </a>
          <div class="article-art" aria-hidden="true">
            {article.visual === 'ads' ? (
              <><span class="market-line line-one"></span><span class="market-line line-two"></span><i>v8</i><b>♻</b></>
            ) : (
              <><span class="inquiry-ring"></span><span class="inquiry-ring ring-two"></span><i>Web</i><b>+</b></>
            )}
          </div>
          <div class="article-copy">
            <div class="article-meta"><span>{article.category}</span><span>{article.source}</span></div>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
            <div class="article-bottom"><span>{article.date}</span><span>Read paper <Icon name="arrow-up-right" size={15} /></span></div>
          </div>
        </article>
      ))}
      <a class="all-writing-card" href={writingArchiveUrl} target="_blank" rel="noreferrer" data-reveal>
        <span>More apps,<br />experiments,<br />and source code.</span>
        <strong>Browse my GitHub <Icon name="arrow-up-right" size={18} /></strong>
      </a>
    </div>
  </section>

  <section class="section builder-section shell" aria-labelledby="builder-title">
    <div class="builder-grid">
      <div class="builder-story" data-reveal>
        <span class="section-kicker">05 / Beyond the job title</span>
        <h2 id="builder-title">Engineer.<br />Researcher.<br /><em>Builder.</em></h2>
        <p class="builder-lead">Before plantations, I researched networks, built cloud backends at Bangkit and shipped a published waste-detection app.</p>
        <p>{spotlight.body}</p>
        <p class="spotlight-links">{spotlight.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} <Icon name="arrow-up-right" size={14} /></a>)}</p>
        <ul class="other-projects">
          {otherProjects.map((item) => (
            <li><a href={item.href} target="_blank" rel="noreferrer"><strong>{item.title}</strong><span>{item.year}</span><small>{item.body}</small></a></li>
          ))}
        </ul>
      </div>

      <div class="builder-cards">
        <a class="builder-card founder-card" href={spotlight.href} data-reveal>
          <span class="builder-card-label">{spotlight.label}</span>
          <Image
            class="card-photo"
            src={defensePhotos[0].src}
            alt={defensePhotos[0].alt}
            widths={[320, 480, 640, 800]}
            sizes="(max-width: 700px) 80vw, 300px"
          />
          <strong>{spotlight.title}</strong>
          <small>Read the case study <Icon name="arrow-up-right" size={15} /></small>
        </a>
        <div class="builder-card education-card" data-reveal>
          <span class="builder-card-label">Foundation</span>
          <Photo class="card-photo" photo={classPhoto} group="class" sizes="(max-width: 700px) 80vw, 300px" widths={[320, 480, 640, 800]} />
          <strong>{education.degree}</strong>
          <p>{education.institution}<br />{education.dates} · {education.score}</p>
          <div class="cert-list">
            {education.certifications.map((cert) => <span><Icon name="check" size={14} /> {cert}</span>)}
          </div>
          <a class="cert-link" href={education.certificationsUrl} target="_blank" rel="noreferrer">Google Cloud Skills Boost profile <Icon name="arrow-up-right" size={14} /></a>
        </div>
        <div class="wedding-card" data-reveal>
          <Photo
            cover
            class="wedding-photo"
            photo={weddingPhotos[0]}
            group="wedding"
            count={weddingPhotos.length}
            sizes="(max-width: 960px) 92vw, 640px"
            widths={[640, 960, 1280, 1800]}
          />
          {weddingPhotos.slice(1).map((photo) => <Photo photo={photo} group="wedding" viewerOnly />)}
          <div class="wedding-copy">
            <span>{wedding.label}</span>
            <strong>{wedding.headline}</strong>
            <p>{wedding.title}. {wedding.body}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section shell" id="contact" aria-labelledby="contact-title" data-reveal>
    <div class="contact-orb" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="contact-portrait">
      <Image src={portrait.src} alt={portrait.alt} widths={[240, 360, 480]} sizes="236px" />
    </div>
    <div class="contact-copy">
      <span class="section-kicker">{pageCopy.contactKicker}</span>
      <h2 id="contact-title">Let’s make it<br /><em>work offline.</em></h2>
      <p>{pageCopy.contactBody}</p>
      <div class="contact-actions">
        <a class="button button-light" href={`mailto:${profile.email}`}>Start a conversation <Icon name="arrow-up-right" size={17} /></a>
        <button class="copy-email" type="button" data-copy-email={profile.email}><span data-copy-label aria-live="polite">{profile.email}</span><small>copy</small></button>
      </div>
    </div>
    <div class="contact-socials">
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>
          <Icon name={link.icon as 'github' | 'linkedin' | 'medium'} size={19} />
        </a>
      ))}
    </div>
  </section>

  <script>
    const setupCopyEmail = () => {
      document.querySelectorAll<HTMLButtonElement>('[data-copy-email]:not([data-ready])').forEach((button) => {
        button.dataset.ready = 'true';
        button.addEventListener('click', async () => {
          const email = button.dataset.copyEmail;
          const label = button.querySelector<HTMLElement>('[data-copy-label]');
          if (!email || !label) return;
          try {
            await navigator.clipboard.writeText(email);
            const previous = label.textContent;
            label.textContent = 'Copied to clipboard';
            window.setTimeout(() => { label.textContent = previous; }, 1800);
          } catch {
            window.location.href = `mailto:${email}`;
          }
        });
      });
    };
    setupCopyEmail();
    document.addEventListener('astro:page-load', setupCopyEmail);
  </script>
</BaseLayout>

<style>
  /* Phones: the wedding photo sits above its text instead of behind it, so the text never covers faces.
     Scoped (unlayered) rules are needed here to beat the Photo component's own absolute positioning. */
  @media (max-width: 560px) {
    .wedding-card {
      display: flex;
      min-height: 0;
      flex-direction: column;
    }
    .wedding-card::after {
      display: none;
    }
    .wedding-card :global(.photo.wedding-photo) {
      position: relative;
      inset: auto;
      aspect-ratio: 3 / 2;
    }
    .wedding-card :global(.photo.wedding-photo .photo-img) {
      height: 100%;
    }
    .wedding-copy {
      position: static;
      max-width: none;
      padding: 22px 22px 26px;
    }
  }
</style>
