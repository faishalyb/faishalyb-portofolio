---
/**
 * Home page. Layout follows design-system/faishal-yusuf-baqir-portfolio/MASTER.md:
 * "Feature-Rich Showcase" — hero with the value proposition, a bento grid of case studies,
 * a call to action after the features, supporting sections, and a closing CTA.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CaseVisual from '../components/CaseVisual.astro';
import FaceCheck from '../components/FaceCheck.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import PhotoLink from '../components/PhotoLink.astro';
import { classPhoto, defensePhotos, logos, portrait, researchPhotos, weddingPhotos } from '../data/photos';
import {
  articles,
  caseStudies,
  education,
  experience,
  expertise,
  githubUrl,
  otherProjects,
  pageCopy,
  profile,
  proofPoints,
  socialLinks,
  spotlight,
  wedding,
} from '../data/site';

// "Sep 2025 – Present" for a company with several roles: start of the oldest, end of the newest.
const span = (roles: { dates: string }[]) => {
  const start = roles[roles.length - 1].dates.split(' – ')[0];
  const end = roles[0].dates.split(' – ')[1] ?? '';
  return end ? `${start} – ${end}` : start;
};
const campusPhotos = [classPhoto, ...defensePhotos];
// The address may wrap only at the @ sign, never mid-word.
const [emailUser, emailDomain] = profile.email.split('@');
// One icon per area of expertise, in the order of `expertise` in site.ts.
const expertiseIcons: IconName[] = ['wifi-off', 'scan-face', 'map-pin'];
---

<Base title={pageCopy.seoTitle} description={pageCopy.seoDescription}>
  <!-- Hero: value proposition, two CTAs, portrait, then the proof points as a bento -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="status"><span class="status-dot" aria-hidden="true"></span>{profile.availability}</p>
        <h1 id="hero-title">
          {pageCopy.heroTitle.lead} <span class="nowrap"><span class="mark">{pageCopy.heroTitle.mark}</span><span class="hero-icon" aria-hidden="true"><Icon name="wifi-off" size={48} /></span></span>
        </h1>
        <p class="hero-lede">{pageCopy.heroSummary}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#work">See the case studies <Icon name="arrow-right" size={18} /></a>
          <a class="btn btn-secondary" href={profile.resume} target="_blank" rel="noopener">Résumé (PDF) <Icon name="download" size={18} /></a>
        </div>
        <p class="hero-meta"><Icon name="map-pin" size={18} />{profile.role} · {profile.location}</p>
      </div>

      <figure class="hero-portrait" data-reveal>
        <svg class="hero-blob" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
          <path d="M44.6,-58.4C57.2,-49.9,66.5,-36.1,71.4,-20.6C76.3,-5.1,76.8,12.1,70.1,25.9C63.4,39.7,49.5,50.1,34.6,58.4C19.7,66.7,3.8,72.9,-12.9,72.1C-29.6,71.3,-47.1,63.5,-58.6,50.4C-70.1,37.3,-75.6,18.6,-74.8,0.7C-74,-17.2,-66.9,-34.4,-55,-43.3C-43.1,-52.2,-26.3,-52.8,-10.3,-55.8C5.8,-58.8,32,-66.9,44.6,-58.4Z" transform="translate(100 100)" />
        </svg>
        <Image src={portrait.src} alt={portrait.alt} widths={[360, 540, 720, 960]} sizes="(max-width: 900px) 80vw, 420px" priority />
        <figcaption class="now">
          <span class="icon-tile"><Icon name="briefcase" size={22} /></span>
          <span class="now-text">
            <span class="label">Now</span>
            <strong>{profile.title}</strong>
            <span>{profile.company}</span>
          </span>
        </figcaption>
      </figure>
    </div>

    <div class="shell">
      <p class="label proof-note">{pageCopy.receiptsIntro}</p>
      <dl class="proof" data-stagger>
        {proofPoints.map((point) => (
          <div class="card proof-card">
            <dt>{point.label}</dt>
            <dd class="proof-value num">{point.value}</dd>
            <dd class="label">{point.source}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 01 Selected work: bento grid of case-study cards, each card one link -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow"><b>01</b> Selected work</p>
        <h2 id="work-title">Field apps, measured.</h2>
        <p>{pageCopy.workIntro}</p>
      </header>

      <ol class="cases" data-stagger>
        {caseStudies.map((project, i) => (
          <li class={`card card-hover case case-${i + 1}`}>
            <div class="case-ev">
              <CaseVisual type={project.visual} />
            </div>
            <div class="case-copy">
              <p class="case-meta">
                <span class="case-chip">{project.label}</span>
                <span class="label">{project.period}</span>
              </p>
              <h3><a class="stretch" href={`/work/${project.slug}`}>{project.title}</a></h3>
              <p class="case-summary">{project.summary}</p>
              <p class="case-outcome"><span class="label">Outcome</span>{project.outcome}</p>
              <ul class="tags">{project.stack.slice(0, 5).map((item) => <li>{item}</li>)}</ul>
              <span class="case-more" aria-hidden="true">Read the case study <Icon name="arrow-right" size={18} /></span>
            </div>
          </li>
        ))}
      </ol>

      <!-- CTA after the features -->
      <div class="card cta-strip" data-reveal>
        <span class="icon-tile"><Icon name="file-text" size={24} /></span>
        <div class="cta-text">
          <h3>Want the full picture?</h3>
          <p>The résumé and the portfolio PDF cover every role and project in one place.</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href={profile.resume} target="_blank" rel="noopener">Résumé (PDF) <Icon name="download" size={18} /></a>
          <a class="btn btn-secondary" href={profile.portfolioPdf} target="_blank" rel="noopener">Portfolio (PDF) <Icon name="download" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 The face check -->
  <FaceCheck index="02" />

  <!-- 03 What I do: three feature cards -->
  <section class="section" aria-labelledby="skills-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow"><b>03</b> What I do</p>
        <h2 id="skills-title">Built for the field, end to end.</h2>
        <p>{pageCopy.expertiseIntro}</p>
      </header>
      <ol class="skills" data-stagger>
        {expertise.map((item, i) => (
          <li class="card skill">
            <span class="icon-tile"><Icon name={expertiseIcons[i] ?? 'code'} size={24} /></span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <ul class="tags">{item.tools.map((tool) => <li>{tool}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 Experience: a timeline of cards -->
  <section class="section exp-section" id="experience" aria-labelledby="exp-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow"><b>04</b> Experience</p>
        <h2 id="exp-title">From a network lab to the plantation field.</h2>
        <p>{pageCopy.journeyIntro}</p>
      </header>

      <ol class="timeline">
        {experience.map((job) => (
          <li class="job" data-reveal>
            <span class="tl-dot" aria-hidden="true"></span>
            <article class="card job-card">
              <div class="job-head">
                <span class="job-logo">
                  {job.logo ? <Image src={logos[job.logo]} alt="" width={112} height={112} /> : <span aria-hidden="true">{job.marker}</span>}
                </span>
                <div class="job-org">
                  <h3>{job.company}</h3>
                  <p class="job-place">{job.location}</p>
                </div>
                <span class="date-chip num">{span(job.roles)}</span>
              </div>
              <ul class="job-roles">
                {job.roles.map((role) => (
                  <li><strong>{role.title}</strong>{job.roles.length > 1 && <span class="label num">{role.dates}</span>}</li>
                ))}
              </ul>
              <p class="job-note">{job.note}</p>
              {job.gallery === 'research' && (
                <div class="job-photos">
                  {researchPhotos.map((photo) => (
                    <PhotoLink photo={photo} group="research" sizes="(max-width: 760px) 44vw, 280px" widths={[320, 480, 640]} />
                  ))}
                </div>
              )}
              {job.link && (
                <a class="text-link" href={job.link.href} target="_blank" rel="noopener">{job.link.label} <Icon name="out" size={16} /></a>
              )}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 05 Writing and side builds -->
  <section class="section writing" id="writing" aria-labelledby="writing-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow"><b>05</b> Writing and side builds</p>
        <h2 id="writing-title">Published research, and smaller builds.</h2>
        <p>{pageCopy.publicationsIntro}</p>
      </header>
      <div class="writing-grid">
        {articles.length > 0 && (
          <div class="writing-col">
            <h3 class="list-title">Publications</h3>
            <ul class="papers" data-stagger>
              {articles.map((article) => (
                <li class="card card-hover paper">
                  <p class="label">{article.date} · {article.source} · {article.category}</p>
                  <a class="paper-link stretch" href={article.href} target="_blank" rel="noopener">
                    {article.title}<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                  <p class="paper-desc">{article.description}</p>
                  <span class="paper-icon" aria-hidden="true"><Icon name="out" size={18} /></span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {otherProjects.length > 0 && (
          <div class="writing-col">
            <h3 class="list-title">Other builds</h3>
            <ul class="builds" data-stagger>
              {otherProjects.map((item) => (
                <li class="card card-hover build">
                  <p class="build-top">
                    <span class="icon-tile"><Icon name="code" size={20} /></span>
                    <span class="label num">{item.year}</span>
                  </p>
                  <a class="build-name stretch" href={item.href} target="_blank" rel="noopener">{item.title}</a>
                  <p class="build-body">{item.body}</p>
                </li>
              ))}
            </ul>
            <a class="text-link" href={githubUrl} target="_blank" rel="noopener"><Icon name="github" size={18} />More code and experiments on GitHub</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 06 Outside the day job: a bento of campus, capstone and weddings -->
  <section class="section" aria-labelledby="beyond-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow"><b>06</b> Outside the day job</p>
        <h2 id="beyond-title">Before the plantations.</h2>
        <p>{pageCopy.beyondLead}</p>
      </header>

      <div class="beyond">
        <div class="beyond-photo" data-reveal>
          <PhotoLink class="campus-photo" photo={campusPhotos[0]} group="campus" count={campusPhotos.length} sizes="(max-width: 900px) 92vw, 600px" widths={[480, 720, 960, 1280]} />
          {campusPhotos.slice(1).map((photo) => <PhotoLink photo={photo} group="campus" viewerOnly />)}
        </div>
        <div class="card edu" data-reveal>
          <span class="icon-tile"><Icon name="graduation-cap" size={24} /></span>
          <p class="label">{education.dates} · {education.score}</p>
          <h3>{education.degree}</h3>
          <p class="muted">{education.institution}</p>
          <ul class="certs">
            {education.certifications.map((cert) => <li><Icon name="check" size={16} />{cert}</li>)}
          </ul>
          <a class="text-link" href={education.certificationsUrl} target="_blank" rel="noopener">Google Cloud Skills Boost profile <Icon name="out" size={16} /></a>
        </div>
        <div class="card capstone" data-reveal>
          <span class="icon-tile"><Icon name="award" size={24} /></span>
          <p class="label">{spotlight.label}</p>
          <h3><a href={spotlight.href}>{spotlight.title}</a></h3>
          <p class="muted">{spotlight.body}</p>
          <ul class="capstone-links">
            {spotlight.links.map((link) => (
              <li><a class="text-link" href={link.href} target="_blank" rel="noopener">{link.label} <Icon name="out" size={15} /></a></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="wedding" data-reveal>
        <PhotoLink class="wedding-photo" photo={weddingPhotos[0]} group="wedding" count={weddingPhotos.length} sizes="(max-width: 900px) 92vw, 1200px" widths={[640, 960, 1280, 1800]} />
        {weddingPhotos.slice(1).map((photo) => <PhotoLink photo={photo} group="wedding" viewerOnly />)}
        <div class="wedding-text">
          <p class="label">{wedding.label}</p>
          <h3>{wedding.headline}</h3>
          <p>{wedding.title}. {wedding.body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 Contact: the closing call to action -->
  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="shell">
      <div class="contact on-primary" data-reveal>
        <div class="contact-head">
          <p class="eyebrow"><b>07</b> Contact</p>
          <h2 id="contact-title">Need an app that keeps working with no signal?</h2>
          <p class="contact-body">{pageCopy.contactBody}</p>
        </div>
        <div class="contact-reach">
          <a class="contact-email" href={`mailto:${profile.email}`}>{emailUser}<wbr />@{emailDomain}</a>
          <div class="contact-actions">
            <a class="btn btn-light" href={`mailto:${profile.email}`}><Icon name="mail" size={18} />Email me</a>
            <button class="btn btn-outline-light" type="button" data-copy={profile.email}>
              <Icon name="copy" size={18} /><span data-copy-label>Copy email address</span>
            </button>
            {socialLinks.map((link) => (
              <a class="btn btn-outline-light" href={link.href} target="_blank" rel="noopener">
                <Icon name={link.icon as 'github' | 'linkedin'} size={18} />{link.label}
              </a>
            ))}
          </div>
        </div>
        <p class="sr-only" aria-live="polite" data-copy-status></p>
      </div>
    </div>
  </section>

  <script>
    const button = document.querySelector<HTMLButtonElement>('[data-copy]');
    const label = button?.querySelector<HTMLElement>('[data-copy-label]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    button?.addEventListener('click', async () => {
      const email = button.dataset.copy ?? '';
      const say = (text: string) => {
        if (label) label.textContent = text;
        if (status) status.textContent = text;
      };
      try {
        await navigator.clipboard.writeText(email);
        say('Copied to clipboard');
      } catch {
        // Clipboard can be blocked by the browser; the address is printed above for copying by hand.
        say('Could not copy. Select the address above');
      }
      window.setTimeout(() => {
        if (label) label.textContent = 'Copy email address';
      }, 3000);
    });
  </script>
</Base>

<style>
  .muted {
    color: var(--color-muted-foreground);
  }

  /* Hero */
  .hero {
    position: relative;
    padding-top: clamp(32px, 6vw, 80px);
    padding-bottom: clamp(48px, 7vw, 88px);
    background:
      radial-gradient(60% 50% at 85% 10%, color-mix(in srgb, var(--color-secondary) 16%, transparent), transparent 70%),
      radial-gradient(50% 40% at 0% 100%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 70%);
  }
  /* In dark mode the page gradient already lights the top; a second glow would leave an edge */
  :global([data-theme='dark']) .hero {
    background: none;
  }
  .hero-grid {
    display: grid;
    gap: 48px;
  }
  .hero-copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 24px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    color: var(--color-foreground);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .status-dot {
    position: relative;
    width: 10px;
    height: 10px;
    background: var(--color-secondary);
    border-radius: 50%;
  }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 2px solid var(--color-secondary);
    border-radius: 50%;
    opacity: 0;
    animation: ping 2.4s var(--ease-out) infinite;
  }
  @keyframes ping {
    0% {
      opacity: 0.7;
      transform: scale(0.6);
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }
  .hero h1 {
    max-width: 14ch;
  }
  .mark {
    color: var(--color-primary);
    background: linear-gradient(transparent 62%, color-mix(in srgb, var(--color-secondary) 24%, transparent) 62%);
  }
  .hero-icon {
    display: inline-block;
    margin-left: 0.18em;
    color: var(--color-secondary);
    vertical-align: -0.04em;
  }
  .hero-icon :global(svg) {
    width: 0.62em;
    height: 0.62em;
  }
  .hero-lede {
    max-width: 54ch;
    color: var(--color-muted-foreground);
    font-size: clamp(1.08rem, 1.5vw, 1.2rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-muted-foreground);
    font-size: 0.95rem;
  }
  .hero-meta :global(.icon) {
    color: var(--color-primary);
  }
  .hero-portrait {
    position: relative;
    width: min(400px, 84%);
    justify-self: center;
    margin-bottom: 28px;
  }
  /* Organic shape peeking out behind the portrait (decorative) */
  .hero-blob {
    position: absolute;
    z-index: 0;
    top: 30%;
    left: -24%;
    width: 85%;
    height: auto;
    max-width: none;
    fill: color-mix(in srgb, var(--color-secondary) 28%, transparent);
  }
  .hero-portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 32px 32px 32px 96px;
    box-shadow: var(--shadow-xl);
  }
  .now {
    position: absolute;
    z-index: 2;
    left: -16px;
    bottom: -28px;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 300px;
    padding: 14px 18px 14px 14px;
    background: var(--color-card-solid);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    line-height: 1.35;
  }
  .now-text {
    display: grid;
  }
  .now strong {
    font-family: var(--font-heading);
    font-size: 1rem;
  }
  .now-text span:last-child {
    color: var(--color-muted-foreground);
    font-size: 0.9rem;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr 380px;
      align-items: center;
      gap: 72px;
    }
    .hero-portrait {
      width: 100%;
    }
  }
  @media (min-width: 1200px) {
    .hero-grid {
      grid-template-columns: 1fr 420px;
    }
  }

  /* Proof points: a bento, the headline number takes the big tile */
  .proof-note {
    margin-top: clamp(56px, 8vw, 88px);
    margin-bottom: 16px;
  }
  .proof {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .proof-card {
    display: grid;
    align-content: end;
    gap: 6px;
    padding: 20px;
  }
  .proof-card dt {
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .proof-value {
    order: -1;
    color: var(--color-foreground);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .proof-card:first-child {
    grid-column: 1 / -1;
    color: #ffffff;
    background: var(--green-900);
    border-color: var(--green-900);
  }
  .proof-card:first-child .proof-value {
    color: #ffffff;
    font-size: clamp(3.4rem, 10vw, 5.2rem);
  }
  .proof-card:first-child .label {
    color: #dff3d2;
  }
  @media (min-width: 900px) {
    .proof {
      grid-template-columns: 1.6fr 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 16px;
    }
    .proof-card {
      padding: 24px;
    }
    .proof-card:first-child {
      grid-column: 1;
      grid-row: 1 / 3;
    }
  }

  /* 01 Cases: bento grid, 7/5 then 5/7 on wide screens */
  .cases {
    display: grid;
    gap: 16px;
  }
  .case {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 24px;
    padding: 16px 16px 24px;
    cursor: pointer;
  }
  .case-ev {
    display: grid;
    min-height: 260px;
    padding: clamp(16px, 3vw, 28px);
    background: var(--color-background);
    border-radius: var(--radius-lg);
    container-type: inline-size;
  }
  .case-copy {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 14px;
    padding-inline: 8px;
  }
  .case-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .case-chip {
    padding: 4px 12px;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .case-copy h3 {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
  }
  .case-copy h3 a:focus-visible {
    outline: none;
  }
  .case:has(a:focus-visible) {
    outline: 3px solid var(--color-ring);
    outline-offset: 3px;
  }
  .case-summary {
    color: var(--color-muted-foreground);
  }
  .case-outcome {
    display: grid;
    gap: 2px;
    width: 100%;
    padding: 12px 16px;
    background: var(--color-primary-soft);
    border-radius: var(--radius-md);
    font-weight: 600;
  }
  .case-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
