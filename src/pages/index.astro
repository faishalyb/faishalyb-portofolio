---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CaseVisual from '../components/CaseVisual.astro';
import FaceCheck from '../components/FaceCheck.astro';
import Icon from '../components/Icon.astro';
import PhotoLink from '../components/PhotoLink.astro';
import SignalMeter from '../components/SignalMeter.astro';
import { classPhoto, defensePhotos, logos, portrait, researchPhotos, weddingPhotos } from '../data/photos';
import {
  articles,
  caseStudies,
  education,
  experience,
  expertise,
  githubUrl,
  otherProjects,
  pageCopy,
  profile,
  proofPoints,
  socialLinks,
  spotlight,
  wedding,
} from '../data/site';

// "Sep 2025 – Present" for a company with several roles: start of the oldest, end of the newest.
const span = (roles: { dates: string }[]) => {
  const start = roles[roles.length - 1].dates.split(' – ')[0];
  const end = roles[0].dates.split(' – ')[1] ?? '';
  return end ? `${start} – ${end}` : start;
};
const campusPhotos = [classPhoto, ...defensePhotos];
---

<Base title={pageCopy.seoTitle} description={pageCopy.seoDescription}>
  <!-- Hero: the headline is the focal point; the portrait and readouts back it up -->
  <section class="hero on-canopy" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="index"><b>{profile.name}</b> {profile.role} · {profile.location}</p>
        <h1 id="hero-title">
          {pageCopy.heroTitle.lead} <span class="nowrap"><span class="mark">{pageCopy.heroTitle.mark}</span><SignalMeter class="hero-meter" /></span>
        </h1>
        <p class="hero-lede">{pageCopy.heroSummary}</p>
        <div class="hero-actions">
          <a class="btn btn-light" href="#work">See the case studies</a>
          <a class="btn btn-line" href={profile.resume} target="_blank" rel="noopener">Download résumé (PDF) <Icon name="download" size={18} /></a>
        </div>
        <p class="hero-status">{profile.availability}.</p>
      </div>

      <figure class="hero-portrait">
        <Image src={portrait.src} alt={portrait.alt} widths={[360, 540, 720, 960]} sizes="(max-width: 900px) 80vw, 420px" priority />
        <figcaption class="now">
          <span class="mono">Now</span>
          <strong>{profile.title}</strong>
          <span>{profile.company}</span>
        </figcaption>
      </figure>
    </div>

    <div class="shell">
      <p class="mono readouts-note">{pageCopy.receiptsIntro}</p>
      <dl class="readouts">
        {proofPoints.map((point) => (
          <div>
            <dt>{point.label}</dt>
            <dd class="readout-value">{point.value}</dd>
            <dd class="mono readout-source">{point.source}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 01 Selected work: wide spreads, evidence on alternating sides -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="index"><b>01</b> Selected work</p>
        <h2 id="work-title">Field apps, measured.</h2>
        <p>{pageCopy.workIntro}</p>
      </header>

      <ol class="cases">
        {caseStudies.map((project) => (
          <li class="case" data-reveal>
            <div class="case-top">
              <span class="case-num" aria-hidden="true">{project.index}</span>
              <span class="mono">{project.label}</span>
              <span class="mono case-period">{project.period}</span>
            </div>
            <div class="case-body">
              <div class="case-copy">
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <p class="case-outcome"><span class="mono">Outcome</span>{project.outcome}</p>
                <ul class="tags">{project.stack.slice(0, 5).map((item) => <li>{item}</li>)}</ul>
                <a class="btn btn-ink case-link" href={`/work/${project.slug}`}>
                  Read the case study<span class="sr-only">: {project.title}</span>
                </a>
              </div>
              <div class="case-ev">
                <CaseVisual type={project.visual} />
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 02 The face check, as an interactive band -->
  <FaceCheck index="02" />

  <!-- 03 What I do: sticky heading, three explanations -->
  <section class="section" aria-labelledby="skills-title">
    <div class="shell skills">
      <header class="skills-head" data-reveal>
        <p class="index"><b>03</b> What I do</p>
        <h2 id="skills-title">Built for the field, end to end.</h2>
        <p>{pageCopy.expertiseIntro}</p>
      </header>
      <ol class="skills-list">
        {expertise.map((item, i) => (
          <li data-reveal>
            <span class="mono">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <p class="mono skills-tools">{item.tools.join(' · ')}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 Experience: a CV-style table -->
  <section class="section exp-section" id="experience" aria-labelledby="exp-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="index"><b>04</b> Experience</p>
        <h2 id="exp-title">From a network lab to the plantation field.</h2>
        <p>{pageCopy.journeyIntro}</p>
        <div class="sec-links">
          <a class="text-link" href={profile.resume} target="_blank" rel="noopener">Résumé (PDF) <Icon name="download" size={16} /></a>
          <a class="text-link" href={profile.portfolioPdf} target="_blank" rel="noopener">Portfolio (PDF) <Icon name="download" size={16} /></a>
        </div>
      </header>

      <ol class="jobs">
        {experience.map((job) => (
          <li class="job" data-reveal>
            <p class="mono job-dates">{span(job.roles)}</p>
            <div class="job-org">
              <span class="job-logo">
                {job.logo ? <Image src={logos[job.logo]} alt="" width={112} height={112} /> : <span aria-hidden="true">{job.marker}</span>}
              </span>
              <div>
                <h3>{job.company}</h3>
                <p class="job-place">{job.location}</p>
              </div>
            </div>
            <div class="job-detail">
              <ul class="job-roles">
                {job.roles.map((role) => (
                  <li><strong>{role.title}</strong><span class="mono">{role.dates}</span></li>
                ))}
              </ul>
              <p>{job.note}</p>
              {job.gallery === 'research' && (
                <div class="job-photos">
                  <PhotoLink photo={researchPhotos[0]} group="research" sizes="(max-width: 700px) 40vw, 200px" widths={[320, 480]} />
                  <PhotoLink photo={researchPhotos[1]} group="research" count={researchPhotos.length} sizes="(max-width: 700px) 56vw, 360px" widths={[480, 720, 960]} />
                  {researchPhotos.slice(2).map((photo) => <PhotoLink photo={photo} group="research" viewerOnly />)}
                </div>
              )}
              {job.link && (
                <a class="text-link" href={job.link.href} target="_blank" rel="noopener">{job.link.label} <Icon name="out" size={16} /></a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 05 Writing and side builds: two plain lists on a panel band -->
  <section class="section writing" id="writing" aria-labelledby="writing-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="index"><b>05</b> Writing and side builds</p>
        <h2 id="writing-title">Published research, and smaller builds.</h2>
        <p>{pageCopy.publicationsIntro}</p>
      </header>
      <div class="writing-grid">
        {articles.length > 0 && (
          <div data-reveal>
            <h3 class="list-title">Publications</h3>
            <ul class="papers">
              {articles.map((article) => (
                <li>
                  <p class="mono">{article.date} · {article.source} · {article.category}</p>
                  <a class="paper-link" href={article.href} target="_blank" rel="noopener">
                    {article.title} <Icon name="out" size={18} />
                  </a>
                  <p class="paper-desc">{article.description}</p>
                </li>
              ))}
            </ul>
          </div>
        )}
        {otherProjects.length > 0 && (
          <div data-reveal>
            <h3 class="list-title">Other builds</h3>
            <ul class="builds">
              {otherProjects.map((item) => (
                <li>
                  <a href={item.href} target="_blank" rel="noopener">
                    <span class="build-name">{item.title} <Icon name="out" size={16} /></span>
                    <span class="mono">{item.year}</span>
                    <span class="build-body">{item.body}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="text-link" href={githubUrl} target="_blank" rel="noopener">More code and experiments on GitHub <Icon name="out" size={16} /></a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 06 Outside the day job: campus, capstone, weddings -->
  <section class="section" aria-labelledby="beyond-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="index"><b>06</b> Outside the day job</p>
        <h2 id="beyond-title">Before the plantations.</h2>
        <p>{pageCopy.beyondLead}</p>
      </header>

      <div class="campus" data-reveal>
        <PhotoLink class="campus-photo" photo={campusPhotos[0]} group="campus" count={campusPhotos.length} sizes="(max-width: 900px) 92vw, 640px" widths={[480, 720, 960, 1280]} />
        {campusPhotos.slice(1).map((photo) => <PhotoLink photo={photo} group="campus" viewerOnly />)}
        <div class="campus-text">
          <div class="edu">
            <p class="mono">{education.dates} · {education.score}</p>
            <h3>{education.degree}</h3>
            <p>{education.institution}</p>
            <ul class="certs">
              {education.certifications.map((cert) => <li>{cert}</li>)}
            </ul>
            <a class="text-link" href={education.certificationsUrl} target="_blank" rel="noopener">Google Cloud Skills Boost profile <Icon name="out" size={16} /></a>
          </div>
          <div class="capstone">
            <p class="mono">{spotlight.label}</p>
            <h3><a href={spotlight.href}>{spotlight.title}</a></h3>
            <p>{spotlight.body}</p>
            <ul class="capstone-links">
              {spotlight.links.map((link) => (
                <li><a class="text-link" href={link.href} target="_blank" rel="noopener">{link.label} <Icon name="out" size={15} /></a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div class="wedding" data-reveal>
        <PhotoLink class="wedding-photo" photo={weddingPhotos[0]} group="wedding" count={weddingPhotos.length} sizes="(max-width: 900px) 92vw, 1240px" widths={[640, 960, 1280, 1800]} />
        {weddingPhotos.slice(1).map((photo) => <PhotoLink photo={photo} group="wedding" viewerOnly />)}
        <div class="wedding-text">
          <p class="mono">{wedding.label}</p>
          <h3>{wedding.headline}</h3>
          <p>{wedding.title}. {wedding.body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact: the closing canopy bookend -->
  <section class="contact on-canopy" id="contact" aria-labelledby="contact-title">
    <div class="shell contact-inner" data-reveal>
      <div class="contact-head">
        <p class="index"><b>07</b> Contact</p>
        <h2 id="contact-title">Need an app that keeps working with no <span class="nowrap">signal?<SignalMeter class="contact-meter" /></span></h2>
      </div>
      <div class="contact-reach">
      <p class="contact-body">{pageCopy.contactBody}</p>
      <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
      <div class="contact-actions">
        <a class="btn btn-fruit" href={`mailto:${profile.email}`}>Email me</a>
        <button class="btn btn-line" type="button" data-copy={profile.email}>
          <Icon name="copy" size={18} /><span data-copy-label>Copy email address</span>
        </button>
        {socialLinks.map((link) => (
          <a class="btn btn-line" href={link.href} target="_blank" rel="noopener">
            <Icon name={link.icon as 'github' | 'linkedin'} size={18} />{link.label}
          </a>
        ))}
      </div>
      </div>
      <p class="sr-only" aria-live="polite" data-copy-status></p>
    </div>
  </section>

  <script>
    const button = document.querySelector<HTMLButtonElement>('[data-copy]');
    const label = button?.querySelector<HTMLElement>('[data-copy-label]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    button?.addEventListener('click', async () => {
      const email = button.dataset.copy ?? '';
      const say = (text: string) => {
        if (label) label.textContent = text;
        if (status) status.textContent = text;
      };
      try {
        await navigator.clipboard.writeText(email);
        say('Copied to clipboard');
      } catch {
        // Clipboard can be blocked by the browser; the address is printed above for copying by hand.
        say('Could not copy. Select the address above');
      }
      window.setTimeout(() => {
        if (label) label.textContent = 'Copy email address';
      }, 3000);
    });
  </script>
</Base>

<style>
  /* Hero */
  .hero {
    padding-top: clamp(40px, 7vw, 96px);
  }
  .hero-grid {
    display: grid;
    gap: 48px;
  }
  .hero-copy {
    display: grid;
    align-content: start;
    gap: 26px;
  }
  .hero h1 {
    max-width: 13ch;
  }
  /* The fruit marker behind "no signal." is the hero's one accent */
  .mark {
    padding: 0 0.08em;
    color: var(--on-fruit);
    background: var(--fruit);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .hero :global(.hero-meter) {
    width: 0.7em;
    margin-left: 0.22em;
    color: var(--on-canopy-muted);
  }
  .hero-lede {
    max-width: 52ch;
    color: var(--on-canopy-muted);
    font-size: clamp(1.08rem, 1.5vw, 1.22rem);
    line-height: 1.55;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero-status {
    color: var(--on-canopy-muted);
    font-size: 0.95rem;
  }
  .hero-portrait {
    position: relative;
    width: min(420px, 86%);
    justify-self: center;
    margin-bottom: 24px;
  }
  .hero-portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius-l);
  }
  /* The "now" card lies on the photo, so it carries the shadow */
  .now {
    position: absolute;
    left: -18px;
    bottom: -24px;
    display: grid;
    max-width: 280px;
    gap: 2px;
    padding: 14px 18px;
    color: var(--ink);
    background: var(--surface);
    border-radius: 14px;
    box-shadow: var(--lift);
    line-height: 1.35;
  }
  .now .mono {
    color: var(--leaf);
  }
  .now strong {
    font-stretch: 88%;
    font-size: 1.08rem;
  }
  .now span:last-child {
    color: var(--muted);
    font-size: 0.92rem;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr 380px;
      align-items: center;
      gap: 64px;
    }
    .hero-portrait {
      width: 100%;
    }
  }
  @media (min-width: 1200px) {
    .hero-grid {
      grid-template-columns: 1fr 420px;
    }
  }

  /* Readouts: number, label, source */
  .readouts-note {
    margin-top: clamp(56px, 8vw, 88px);
    padding-top: 18px;
    color: var(--on-canopy-muted);
    border-top: 1px solid var(--canopy-line);
  }
  .readouts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 20px;
    padding-block: 22px clamp(48px, 7vw, 72px);
  }
  .readouts > div {
    display: grid;
    align-content: start;
    gap: 6px;
  }
  .readouts > div:first-child {
    grid-column: 1 / -1;
  }
  .readout-value {
    order: -1;
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    font-stretch: 75%;
    font-weight: 800;
    line-height: 0.95;
  }
  .readouts > div:first-child .readout-value {
    font-size: clamp(4.4rem, 14vw, 6.6rem);
  }
  .readouts dt {
    color: var(--on-canopy);
    font-size: 0.98rem;
    line-height: 1.4;
  }
  .readout-source {
    color: var(--on-canopy-muted);
  }
  @media (min-width: 1000px) {
    .readouts {
      grid-template-columns: 1.5fr repeat(4, 1fr);
      gap: 0;
    }
    .readouts > div:first-child {
      grid-column: auto;
    }
    .readouts > div {
      padding-inline: 22px;
      border-left: 1px solid var(--canopy-line);
    }
    .readouts > div:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  /* Section heading block, shared by most sections */
  .sec-head {
    display: grid;
    gap: 18px;
    max-width: 860px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .sec-head > p:not(.index) {
    max-width: 60ch;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .sec-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  /* 01 Cases */
  .cases {
    display: grid;
    gap: clamp(64px, 9vw, 112px);
  }
  .case-top {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: 4px 20px;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
  }
  .case-num {
    grid-row: span 2;
    font-size: clamp(4rem, 10vw, 7rem);
    font-stretch: 72%;
    font-weight: 800;
    line-height: 0.8;
  }
  .case-top .mono {
    color: var(--muted);
  }
  .case-top .case-period {
    color: var(--ink);
  }
  .case-body {
    display: grid;
    gap: 28px;
    margin-top: 28px;
  }
  .case-copy {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 18px;
  }
  .case-copy h3 {
    font-size: clamp(1.8rem, 3.4vw, 2.7rem);
    font-stretch: 80%;
    font-weight: 800;
    line-height: 1.02;
  }
  .case-copy > p {
    max-width: 58ch;
    color: var(--muted);
  }
  .case-copy > .case-outcome {
    display: grid;
    gap: 2px;
    color: var(--ink);
    font-size: 1.12rem;
    font-weight: 650;
  }
  .case-outcome .mono {
    color: var(--muted);
  }
  .case-link {
    margin-top: 6px;
  }
  .case-ev {
    display: grid;
    min-height: 300px;
    padding: clamp(20px, 4vw, 40px);
    background: var(--panel);
    border-radius: var(--radius-l);
  }
  @media (min-width: 960px) {
    .case-body {
      grid-template-columns: 5fr 6fr;
      gap: 56px;
    }
    .case:nth-child(even) .case-copy {
      order: 2;
    }
  }

  /* 03 Skills: sticky heading on wide screens */
  .skills {
    display: grid;
    gap: 40px 80px;
  }
  .skills-head {
    display: grid;
    align-content: start;
    gap: 18px;
  }
  .skills-head > p:not(.index) {
    max-width: 48ch;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .skills-list li {
    display: grid;
    gap: 10px;
    padding-block: 28px;
    border-top: 1px solid var(--line-strong);
  }
  .skills-list li:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .skills-list .mono {
    color: var(--muted);
  }
  .skills-list h3 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-stretch: 78%;
    font-weight: 800;
  }
  .skills-list p:not(.mono) {
    max-width: 56ch;
  }
  .skills-list .skills-tools {
    color: var(--ink);
  }
  @media (min-width: 960px) {
    .skills {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .skills-head {
      position: sticky;
      top: calc(var(--header) + 40px);
      align-self: start;
    }
  }

  /* 04 Experience */
  .exp-section {
    padding-top: 0;
  }
  .jobs {
    border-top: 2px solid var(--ink);
  }
  .job {
    display: grid;
    gap: 16px;
    padding-block: 32px;
    border-bottom: 1px solid var(--line-strong);
  }
  /* On a phone each role already shows its dates, so the span column is dropped */
  .job-dates {
    display: none;
    color: var(--muted);
  }
  .job-org {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .job-logo {
    display: grid;
    flex: none;
    width: 60px;
    height: 60px;
    place-items: center;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    font-family: var(--font-mono);
  }
  .job-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .job-org h3 {
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
  }
  .job-place {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .job-detail {
    display: grid;
    justify-items: start;
    gap: 14px;
    min-width: 0;
  }
  .job-detail > p {
    max-width: 62ch;
    color: var(--muted);
  }
  .job-roles {
    display: grid;
    width: 100%;
    gap: 6px;
  }
  .job-roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
  }
  .job-roles .mono {
    color: var(--muted);
  }
  .job-photos {
    display: grid;
    grid-template-columns: 2fr 3fr;
    width: 100%;
    max-width: 560px;
    gap: 10px;
  }
  .job-photos > :global(.photo-link) {
    aspect-ratio: 4 / 3;
  }
  .job-photos > :global(.photo-link:first-child) {
    aspect-ratio: auto;
  }
  @media (min-width: 960px) {
    .job {
      grid-template-columns: 170px 1fr 1.4fr;
      gap: 32px;
      align-items: start;
    }
    .job-dates {
      display: block;
      padding-top: 6px;
    }
    .job-org {
      align-items: flex-start;
    }
  }

  /* 05 Writing */
  .writing {
    background: var(--panel);
  }
  .writing-grid {
