---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import Receipt from '../components/Receipt.astro';
import { avatar, classPhoto, defensePhotos, logos, portrait, researchPhotos, weddingPhotos } from '../data/photos';
import {
  articles,
  caseStudies,
  education,
  experience,
  expertise,
  githubUrl,
  otherProjects,
  pageCopy,
  profile,
  proofPoints,
  socialLinks,
  spotlight,
  wedding,
} from '../data/site';
---

<BaseLayout title={pageCopy.seoTitle} description={pageCopy.seoDescription}>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-id">
        <Image src={avatar.src} alt="" width={112} height={112} priority />
        <span><strong>{profile.name}</strong><br />{profile.role}, {profile.location}</span>
      </p>
      <h1 id="hero-title">I build apps that work <em>where the signal <span class="mark">doesn’t.</span></em></h1>
      <p class="hero-lede">{pageCopy.heroSummary}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">See the case studies</a>
        <a class="btn btn-ghost" href={profile.resume} target="_blank" rel="noopener noreferrer">Download résumé (PDF) <Icon name="download" size={17} /></a>
      </div>
    </div>
    <Receipt />
  </section>

  <section class="receipts shell" aria-labelledby="receipts-title">
    <hr class="tear" />
    <div class="receipts-head">
      <h2 id="receipts-title" class="label">Receipts</h2>
      <p>{pageCopy.receiptsIntro}</p>
    </div>
    <dl>
      {proofPoints.map((proof) => (
        <div>
          <dt>{proof.label}</dt>
          <dd><strong>{proof.value}</strong><small>{proof.source}</small></dd>
        </div>
      ))}
    </dl>
    <hr class="tear" />
  </section>

  <section class="section shell" id="work" aria-labelledby="work-title">
    <div class="intro" data-reveal>
      <div>
        <span class="label">01 Selected work</span>
        <h2 id="work-title">Field apps with <em>receipts.</em></h2>
      </div>
      <p>{pageCopy.workIntro}</p>
    </div>

    <div class="cases">
      {caseStudies.map((project) => (
        <article class="case card" data-reveal>
          <div class="case-copy">
            <span class="label">{project.index} {project.label}</span>
            <h3><a href={`/work/${project.slug}`}>{project.title}</a></h3>
            <p>{project.summary}</p>
            <ul class="tags">{project.stack.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
            <p class="case-outcome"><span class="label">Outcome</span>{project.outcome}</p>
            <span class="case-more" aria-hidden="true">Read the case study</span>
          </div>
          <div class="case-visual"><ProjectVisual type={project.visual} /></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section band" aria-labelledby="expertise-title">
    <div class="shell">
      <div class="intro" data-reveal>
        <div>
          <span class="label">02 What I do</span>
          <h2 id="expertise-title">Built for the field, <em>end to end.</em></h2>
        </div>
        <p>{pageCopy.expertiseIntro}</p>
      </div>

      <div class="skills" data-reveal>
        {expertise.map((item) => (
          <div class="skill">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <ul class="tags">{item.tools.map((tool) => <li>{tool}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section shell journey" id="journey" aria-labelledby="journey-title">
    <div class="journey-head" data-reveal>
      <span class="label">03 The journey</span>
      <h2 id="journey-title">From the research lab to the <em>plantation field.</em></h2>
      <p>{pageCopy.journeyIntro}</p>
      <div class="link-row">
        <a class="text-link" href={profile.resume} target="_blank" rel="noopener noreferrer">Résumé (PDF) <Icon name="download" size={15} /></a>
        <a class="text-link" href={profile.portfolioPdf} target="_blank" rel="noopener noreferrer">Portfolio (PDF) <Icon name="download" size={15} /></a>
      </div>
    </div>

    <ol class="timeline">
      {experience.map((item) => (
        <li class="stop" data-reveal>
          <div class="stop-logo">
            {item.logo ? <Image src={logos[item.logo]} alt="" width={112} height={112} /> : <span aria-hidden="true">{item.marker}</span>}
          </div>
          <div class="stop-copy">
            <h3>{item.company}</h3>
            <p class="stop-place">{item.location}</p>
            <ul class="stop-roles">
              {item.roles.map((role) => <li><strong>{role.title}</strong><span>{role.dates}</span></li>)}
            </ul>
            <p>{item.note}</p>
            {item.gallery === 'research' && (
              <div class="jrow stop-photos">
                <Photo photo={researchPhotos[0]} group="research" sizes="(max-width: 960px) 30vw, 180px" widths={[320, 480, 640]} />
                <Photo photo={researchPhotos[1]} group="research" count={researchPhotos.length} sizes="(max-width: 960px) 62vw, 400px" widths={[480, 640, 960, 1280]} />
                {researchPhotos.slice(2).map((photo) => <Photo photo={photo} group="research" viewerOnly />)}
              </div>
            )}
            {item.link && (
              <a class="text-link" href={item.link.href} target="_blank" rel="noopener noreferrer">{item.link.label} <Icon name="arrow-up-right" size={15} /></a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section band" id="publications" aria-labelledby="publications-title">
    <div class="shell">
      <div class="intro" data-reveal>
        <div>
          <span class="label">04 Publications</span>
          <h2 id="publications-title">Research, <em>published.</em></h2>
        </div>
        <p>{pageCopy.publicationsIntro}</p>
      </div>

      <ul class="papers" data-reveal>
        {articles.map((article) => (
          <li>
            <span class="paper-meta">{article.date} · {article.source}</span>
            <h3><a href={article.href} target="_blank" rel="noopener noreferrer">{article.title} <Icon name="arrow-up-right" size={18} /></a></h3>
            <p>{article.description}</p>
          </li>
        ))}
      </ul>
      <a class="text-link" href={githubUrl} target="_blank" rel="noopener noreferrer">More code and experiments on GitHub <Icon name="arrow-up-right" size={15} /></a>
    </div>
  </section>

  <section class="section shell beyond" aria-labelledby="beyond-title">
    <div class="beyond-story" data-reveal>
      <span class="label">05 Beyond the job title</span>
      <h2 id="beyond-title">Engineer. Researcher. <em>Builder.</em></h2>
      <p class="beyond-lead">{pageCopy.beyondLead}</p>
      <p>{spotlight.body}</p>
      <div class="link-row">
        {spotlight.links.map((link) => (
          <a class="text-link" href={link.href} target="_blank" rel="noreferrer">{link.label} <Icon name="arrow-up-right" size={15} /></a>
        ))}
      </div>
      <h3 class="beyond-sub">Other projects</h3>
      <ul class="others">
        {otherProjects.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noreferrer">
              <strong>{item.title} <Icon name="arrow-up-right" size={14} /></strong>
              <span>{item.year}</span>
              <small>{item.body}</small>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="beyond-cards">
      <article class="card photo-card" data-reveal>
        <span class="label">{spotlight.label}</span>
        <Image
          class="card-photo"
          src={defensePhotos[0].src}
          alt={defensePhotos[0].alt}
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 700px) 86vw, 300px"
        />
        <h3><a href={spotlight.href}>{spotlight.title}</a></h3>
        <span class="case-more" aria-hidden="true">Read the case study</span>
      </article>

      <article class="card photo-card" data-reveal>
        <span class="label">Foundation</span>
        <Photo class="card-photo" photo={classPhoto} group="class" sizes="(max-width: 700px) 86vw, 300px" widths={[320, 480, 640, 800]} />
        <h3>{education.degree}</h3>
        <p>{education.institution}<br />{education.dates} · {education.score}</p>
        <ul class="certs">
          {education.certifications.map((cert) => <li>{cert}</li>)}
        </ul>
        <a class="text-link" href={education.certificationsUrl} target="_blank" rel="noreferrer">Google Cloud Skills Boost profile <Icon name="arrow-up-right" size={15} /></a>
      </article>

      <article class="wedding" data-reveal>
        <Photo
          cover
          class="wedding-photo"
          photo={weddingPhotos[0]}
          group="wedding"
          count={weddingPhotos.length}
          sizes="(max-width: 960px) 92vw, 640px"
          widths={[640, 960, 1280, 1800]}
        />
        {weddingPhotos.slice(1).map((photo) => <Photo photo={photo} group="wedding" viewerOnly />)}
        <div class="wedding-copy">
          <span class="label">{wedding.label}</span>
          <h3>{wedding.headline}</h3>
          <p>{wedding.title}. {wedding.body}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="contact shell" id="contact" aria-labelledby="contact-title" data-reveal>
    <div class="contact-copy">
      <span class="label">Building something for the field?</span>
      <h2 id="contact-title">Let’s make it <em>work offline.</em></h2>
      <p>{pageCopy.contactBody}</p>
      <div class="contact-actions">
        <a class="btn contact-primary" href={`mailto:${profile.email}`}>Email me</a>
        <button class="btn contact-copy-btn" type="button" data-copy-email={profile.email}>
          <span data-copy-label aria-live="polite">{profile.email}</span><small>Copy</small>
        </button>
      </div>
      <ul class="contact-socials">
        {socialLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>
              <Icon name={link.icon as 'github' | 'linkedin'} size={20} />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="contact-portrait">
      <Image src={portrait.src} alt={portrait.alt} widths={[240, 360, 480, 640]} sizes="(max-width: 860px) 60vw, 280px" />
    </div>
  </section>

  <script>
    const setupCopyEmail = () => {
      document.querySelectorAll<HTMLButtonElement>('[data-copy-email]:not([data-ready])').forEach((button) => {
        button.dataset.ready = 'true';
        button.addEventListener('click', async () => {
          const email = button.dataset.copyEmail;
          const label = button.querySelector<HTMLElement>('[data-copy-label]');
          if (!email || !label) return;
          try {
            await navigator.clipboard.writeText(email);
            label.textContent = 'Copied to clipboard';
            window.setTimeout(() => { label.textContent = email; }, 1800);
          } catch {
            window.location.href = `mailto:${email}`;
          }
        });
      });
    };
    setupCopyEmail();
    document.addEventListener('astro:page-load', setupCopyEmail);
  </script>
</BaseLayout>

<style>
  /* Hero: the headline is the focal point; the receipt is the evidence beside it */
  .hero {
    display: grid;
    gap: 48px;
    padding-block: clamp(36px, 6vw, 80px) clamp(56px, 8vw, 96px);
  }
  .hero-id {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    line-height: 1.35;
  }
  .hero-id img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
  }
  .hero-id strong {
    color: var(--ink);
  }
  .hero h1 {
    margin-top: 26px;
  }
  /* The amber marker under one word is this screen's single accent */
  .mark {
    text-decoration: underline;
    text-decoration-color: var(--amber);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.12em;
  }
  .hero-lede {
    max-width: 54ch;
    margin-top: 24px;
    color: var(--muted);
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      gap: 64px;
    }
  }

  /* Receipts: numbers as line items, each with its source */
  .receipts-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 18px;
    padding-top: 22px;
  }
  .receipts-head h2 {
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  .receipts-head p {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .receipts dl {
    display: grid;
    padding-block: 10px 22px;
  }
  .receipts dl > div {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px dashed var(--line-strong);
  }
  .receipts dl > div:last-child {
    border-bottom: 0;
  }
  .receipts dt {
    color: var(--muted);
  }
  .receipts dd {
    display: grid;
    justify-items: end;
    text-align: right;
  }
  .receipts strong {
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .receipts small {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  @media (min-width: 960px) {
    .receipts dl {
      grid-template-columns: repeat(5, 1fr);
      padding-block: 18px 26px;
    }
    .receipts dl > div {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 8px;
      padding: 0 18px;
      border-bottom: 0;
      border-left: 1px dashed var(--line-strong);
    }
    .receipts dl > div:first-child {
      padding-left: 0;
      border-left: 0;
    }
    .receipts dt {
      order: 2;
      font-size: 0.92rem;
    }
    .receipts dd {
      justify-items: start;
      text-align: left;
    }
    .receipts strong {
      font-size: 2.3rem;
    }
  }

  /* Case studies: wide rows, text on one side and evidence on the other */
  .cases {
    display: grid;
    gap: 22px;
  }
  .case {
    position: relative;
    display: grid;
    overflow: hidden;
    transition: border-color 180ms ease;
  }
  .case:hover {
    border-color: var(--ink);
  }
  .case-copy {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: clamp(22px, 4vw, 44px);
  }
  .case-copy > p {
    color: var(--muted);
  }
  /* The heading link covers the whole card */
  .case h3 a::after,
  .photo-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .case h3 a:focus-visible,
  .photo-card h3 a:focus-visible {
    outline: none;
  }
  .case h3 a:focus-visible::after,
  .photo-card h3 a:focus-visible::after {
    outline: 3px solid var(--green);
    outline-offset: -3px;
    border-radius: var(--radius-l);
  }
  .case-copy > .case-outcome {
    display: grid;
    gap: 2px;
    padding-top: 14px;
    border-top: 1px dashed var(--line-strong);
    color: var(--ink);
    font-weight: 650;
  }
  .case-more {
    color: var(--green);
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .case:hover .case-more,
  .photo-card:hover .case-more {
    text-decoration-thickness: 2px;
  }
  .case:active .case-more,
  .photo-card:active .case-more {
    opacity: 0.7;
  }
  .case-visual {
    display: grid;
    min-height: 320px;
    padding: clamp(22px, 4vw, 44px);
    background: var(--paper-deep);
  }
  @media (min-width: 900px) {
    .case {
      grid-template-columns: 1fr 1fr;
    }
    .case:nth-child(even) .case-copy {
      order: 2;
    }
  }

  /* What I do: rows of text, because the content is three explanations, not three features */
  .skill {
    display: grid;
    gap: 12px 40px;
    padding-block: 26px;
    border-top: 1px solid var(--line-strong);
  }
  .skill:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .skill p {
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .skill {
      grid-template-columns: 0.8fr 1.2fr 1fr;
      align-items: start;
    }
  }

  /* Journey */
  .journey {
    display: grid;
    gap: 44px 72px;
  }
  .journey-head h2 {
    margin-top: 12px;
  }
  .journey-head > p {
    max-width: 44ch;
    margin-block: 20px 8px;
    color: var(--muted);
  }
  .timeline {
    display: grid;
    gap: 44px;
  }
  .stop {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 18px;
  }
  .stop-logo {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    font-family: var(--font-mono);
  }
  .stop-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stop-copy {
    display: grid;
    gap: 10px;
    min-width: 0;
  }
  .stop-copy > p {
    color: var(--muted);
  }
  .stop-copy > .stop-place {
    font-size: 0.92rem;
  }
  .stop-roles {
    display: grid;
    gap: 6px;
    padding-block: 12px;
    border-block: 1px solid var(--line);
  }
  .stop-roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
  }
  .stop-roles span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }
  .stop-photos {
    margin-top: 6px;
  }
  @media (min-width: 960px) {
    .journey {
      grid-template-columns: 0.8fr 1.2fr;
    }
    .journey-head {
      position: sticky;
      top: calc(var(--header) + 32px);
      align-self: start;
    }
  }
  @media (max-width: 560px) {
    .stop-photos > :global(.ar-13) {
      display: none;
    }
  }

  /* Publications: a plain list */
  .papers {
    margin-bottom: 14px;
  }
  .papers li {
    display: grid;
    gap: 8px;
    padding-block: 24px;
    border-top: 1px solid var(--line-strong);
  }
  .papers li:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .paper-meta {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }
  .papers h3 {
    max-width: 30ch;
  }
  .papers h3 a:hover {
    color: var(--green);
  }
  .papers h3 a:active {
    opacity: 0.75;
  }
  .papers h3 :global(.icon) {
    display: inline;
    vertical-align: baseline;
  }
  .papers p {
    max-width: 62ch;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .papers li {
      grid-template-columns: 220px 1fr;
      gap: 8px 40px;
    }
    .papers p {
      grid-column: 2;
    }
  }

  /* Beyond the job title */
  .beyond {
    display: grid;
    gap: 44px 64px;
  }
  .beyond-story h2 {
    margin-top: 12px;
  }
  .beyond-story > p {
    max-width: 52ch;
    margin-top: 14px;
    color: var(--muted);
  }
  .beyond-story > .beyond-lead {
    margin-top: 24px;
    color: var(--ink);
    font-size: 1.2rem;
    line-height: 1.45;
  }
  .beyond-story .link-row {
    margin-top: 8px;
  }
  .beyond-sub {
    margin-top: 28px;
    font-size: 1.1rem;
  }
  .others {
    display: grid;
    margin-top: 10px;
  }
  .others a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    min-height: 44px;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }
  .others strong {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .others a:hover strong {
    color: var(--green);
  }
  .others a:active {
    opacity: 0.75;
  }
  .others span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }
  .others small {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .beyond-cards {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .photo-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 22px;
    transition: border-color 180ms ease;
  }
  .photo-card:has(h3 a):hover {
    border-color: var(--ink);
  }
  .photo-card :global(.card-photo) {
    width: 100%;
    border-radius: 12px;
  }
  .photo-card :global(img.card-photo) {
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: 50% 62%;
  }
  .photo-card > p {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .certs {
    display: grid;
  }
  .certs li {
    padding-block: 8px;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .wedding {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    color: #fff;
    background: #1b1a1f;
    border-radius: var(--radius-l);
  }
  /* Dark scrim so the text stays readable over the photo */
  .wedding::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
