---
/**
 * Home page. Tokens, type and components follow design-system/faishal-yusuf-baqir-portfolio/MASTER.md;
 * the page pattern is the override in design-system/faishal-yusuf-baqir-portfolio/pages/home.md:
 * a scroll-scrubbed estate scene as the hero, the case studies as a reel, the experience as a
 * trail that inks itself, then the supporting sections and a closing CTA.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EstateScene from '../components/EstateScene.astro';
import FaceCheck from '../components/FaceCheck.astro';
import Journey from '../components/Journey.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import PhotoLink from '../components/PhotoLink.astro';
import WorkReel from '../components/WorkReel.astro';
import { classPhoto, defensePhotos, portrait, weddingPhotos } from '../data/photos';
import {
  articles,
  education,
  expertise,
  githubUrl,
  otherProjects,
  pageCopy,
  profile,
  proofPoints,
  socialLinks,
  spotlight,
  wedding,
} from '../data/site';

const campusPhotos = [classPhoto, ...defensePhotos];
// The address may wrap only at the @ sign, never mid-word.
const [emailUser, emailDomain] = profile.email.split('@');
// One icon per area of expertise, in the order of `expertise` in site.ts.
const expertiseIcons: IconName[] = ['wifi-off', 'scan-face', 'map-pin'];
---

<Base title={pageCopy.seoTitle} description={pageCopy.seoDescription}>
  <!-- Hero: the estate at first light, scrubbed by the scroll -->
  <EstateScene />

  <!-- Field log: what I do, the two CTAs, the portrait and the proof points -->
  <section class="log" id="log" aria-labelledby="log-title" data-scene-end>
    <div class="shell log-grid">
      <div class="log-copy" data-reveal>
        <p class="eyebrow"><b>00</b> Field log</p>
        <h2 id="log-title">{pageCopy.receiptsIntro}</h2>
        <p class="log-lede">{pageCopy.heroSummary}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#work">See the case studies <Icon name="arrow-right" size={18} /></a>
          <a class="btn btn-secondary" href={profile.resume} target="_blank" rel="noopener">Résumé (PDF) <Icon name="download" size={18} /></a>
        </div>
        <p class="status"><span class="status-dot" aria-hidden="true"></span>{profile.availability}</p>
      </div>

      <figure class="hero-portrait" data-reveal>
        <Image src={portrait.src} alt={portrait.alt} widths={[360, 540, 720, 960]} sizes="(max-width: 900px) 80vw, 420px" />
        <figcaption class="now">
          <span class="icon-tile"><Icon name="briefcase" size={22} /></span>
          <span class="now-text">
            <span class="label">Now</span>
            <strong>{profile.title}</strong>
            <span>{profile.company}</span>
          </span>
        </figcaption>
      </figure>
    </div>

    <div class="shell">
      <dl class="proof" data-stagger>
        {proofPoints.map((point) => (
          <div class="card proof-card">
            <dt>{point.label}</dt>
            <dd class="proof-value num">{point.value}</dd>
            <dd class="label">{point.source}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 01 Selected work: the case studies as a reel that slides past on the scroll -->
  <WorkReel />

  <!-- 02 The face check -->
  <FaceCheck index="02" />

  <!-- 03 What I do: three feature cards -->
  <section class="section" aria-labelledby="skills-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow"><b>03</b> What I do</p>
        <h2 id="skills-title">Built for the field, end to end.</h2>
        <p>{pageCopy.expertiseIntro}</p>
      </header>
      <ol class="skills" data-stagger>
        {expertise.map((item, i) => (
          <li class="card skill">
            <span class="icon-tile"><Icon name={expertiseIcons[i] ?? 'code'} size={24} /></span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <ul class="tags">{item.tools.map((tool) => <li>{tool}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 Experience: a trail that inks itself from stop to stop -->
  <Journey />

  <!-- 05 Writing and side builds -->
  <section class="section writing" id="writing" aria-labelledby="writing-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow"><b>05</b> Writing and side builds</p>
        <h2 id="writing-title">Published research, and smaller builds.</h2>
        <p>{pageCopy.publicationsIntro}</p>
      </header>
      <div class="writing-grid">
        {articles.length > 0 && (
          <div class="writing-col">
            <h3 class="list-title">Publications</h3>
            <ul class="papers" data-stagger>
              {articles.map((article) => (
                <li class="card card-hover paper">
                  <p class="label">{article.date} · {article.source} · {article.category}</p>
                  <a class="paper-link stretch" href={article.href} target="_blank" rel="noopener">
                    {article.title}<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                  <p class="paper-desc">{article.description}</p>
                  <span class="paper-icon" aria-hidden="true"><Icon name="out" size={18} /></span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {otherProjects.length > 0 && (
          <div class="writing-col">
            <h3 class="list-title">Other builds</h3>
            <ul class="builds" data-stagger>
              {otherProjects.map((item) => (
                <li class="card card-hover build">
                  <p class="build-top">
                    <span class="icon-tile"><Icon name="code" size={20} /></span>
                    <span class="label num">{item.year}</span>
                  </p>
                  <a class="build-name stretch" href={item.href} target="_blank" rel="noopener">{item.title}</a>
                  <p class="build-body">{item.body}</p>
                </li>
              ))}
            </ul>
            <a class="text-link" href={githubUrl} target="_blank" rel="noopener"><Icon name="github" size={18} />More code and experiments on GitHub</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 06 Outside the day job: a bento of campus, capstone and weddings -->
  <section class="section" aria-labelledby="beyond-title">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow"><b>06</b> Outside the day job</p>
        <h2 id="beyond-title">Before the plantations.</h2>
        <p>{pageCopy.beyondLead}</p>
      </header>

      <div class="beyond">
        <div class="beyond-photo" data-reveal>
          <PhotoLink class="campus-photo" photo={campusPhotos[0]} group="campus" count={campusPhotos.length} sizes="(max-width: 900px) 92vw, 600px" widths={[480, 720, 960, 1280]} />
          {campusPhotos.slice(1).map((photo) => <PhotoLink photo={photo} group="campus" viewerOnly />)}
        </div>
        <div class="card edu" data-reveal>
          <span class="icon-tile"><Icon name="graduation-cap" size={24} /></span>
          <p class="label">{education.dates} · {education.score}</p>
          <h3>{education.degree}</h3>
          <p class="muted">{education.institution}</p>
          <ul class="certs">
            {education.certifications.map((cert) => <li><Icon name="check" size={16} />{cert}</li>)}
          </ul>
          <a class="text-link" href={education.certificationsUrl} target="_blank" rel="noopener">Google Cloud Skills Boost profile <Icon name="out" size={16} /></a>
        </div>
        <div class="card capstone" data-reveal>
          <span class="icon-tile"><Icon name="award" size={24} /></span>
          <p class="label">{spotlight.label}</p>
          <h3><a href={spotlight.href}>{spotlight.title}</a></h3>
          <p class="muted">{spotlight.body}</p>
          <ul class="capstone-links">
            {spotlight.links.map((link) => (
              <li><a class="text-link" href={link.href} target="_blank" rel="noopener">{link.label} <Icon name="out" size={15} /></a></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="wedding" data-reveal>
        <PhotoLink class="wedding-photo" photo={weddingPhotos[0]} group="wedding" count={weddingPhotos.length} sizes="(max-width: 900px) 92vw, 1200px" widths={[640, 960, 1280, 1800]} />
        {weddingPhotos.slice(1).map((photo) => <PhotoLink photo={photo} group="wedding" viewerOnly />)}
        <div class="wedding-text">
          <p class="label">{wedding.label}</p>
          <h3>{wedding.headline}</h3>
          <p>{wedding.title}. {wedding.body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 Contact: the closing call to action -->
  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="shell">
      <div class="contact on-primary" data-reveal>
        <div class="contact-head">
          <p class="eyebrow"><b>07</b> Contact</p>
          <h2 id="contact-title">Need an app that keeps working with no signal?</h2>
          <p class="contact-body">{pageCopy.contactBody}</p>
        </div>
        <div class="contact-reach">
          <a class="contact-email" href={`mailto:${profile.email}`}>{emailUser}<wbr />@{emailDomain}</a>
          <div class="contact-actions">
            <a class="btn btn-light" href={`mailto:${profile.email}`}><Icon name="mail" size={18} />Email me</a>
            <button class="btn btn-outline-light" type="button" data-copy={profile.email}>
              <Icon name="copy" size={18} /><span data-copy-label>Copy email address</span>
            </button>
            {socialLinks.map((link) => (
              <a class="btn btn-outline-light" href={link.href} target="_blank" rel="noopener">
                <Icon name={link.icon as 'github' | 'linkedin'} size={18} />{link.label}
              </a>
            ))}
          </div>
        </div>
        <p class="sr-only" aria-live="polite" data-copy-status></p>
      </div>
    </div>
  </section>

  <script>
    const button = document.querySelector<HTMLButtonElement>('[data-copy]');
    const label = button?.querySelector<HTMLElement>('[data-copy-label]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    button?.addEventListener('click', async () => {
      const email = button.dataset.copy ?? '';
      const say = (text: string) => {
        if (label) label.textContent = text;
        if (status) status.textContent = text;
      };
      try {
        await navigator.clipboard.writeText(email);
        say('Copied to clipboard');
      } catch {
        // Clipboard can be blocked by the browser; the address is printed above for copying by hand.
        say('Could not copy. Select the address above');
      }
      window.setTimeout(() => {
        if (label) label.textContent = 'Copy email address';
      }, 3000);
    });
  </script>
</Base>

<style>
  .muted {
    color: var(--color-muted-foreground);
  }

  /*
   * Field log: the first section after the scene. It slides up over the still-pinned stage,
   * with a band of mist (the page colour) rolling in ahead of it.
   */
  .log {
    position: relative;
    z-index: 2;
    padding-block: clamp(40px, 6vw, 80px) clamp(56px, 8vw, 104px);
    background: var(--color-background);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.has-js) .log {
      margin-top: -100vh;
      margin-top: -100svh;
    }
    /* The band of mist; EstateScene.astro times the scene's last frame to end before it arrives (MIST) */
    :global(.has-js) .log::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: calc(100% - 1px);
      height: 30vh;
      pointer-events: none;
      background: linear-gradient(180deg, transparent, var(--color-background));
    }
  }
  .log-grid {
    display: grid;
    gap: 48px;
  }
  .log-copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 24px;
  }
  .log-copy h2 {
    max-width: 16ch;
  }
  .log-lede {
    max-width: 54ch;
    color: var(--color-muted-foreground);
    font-size: clamp(1.08rem, 1.5vw, 1.2rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    color: var(--color-foreground);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .status-dot {
    position: relative;
    width: 10px;
    height: 10px;
    background: var(--color-secondary);
    border-radius: 50%;
  }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 2px solid var(--color-secondary);
    border-radius: 50%;
    opacity: 0;
    animation: ping 2.4s var(--ease-out) infinite;
  }
  @keyframes ping {
    0% {
      opacity: 0.7;
      transform: scale(0.6);
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }
  .hero-portrait {
    position: relative;
    width: min(360px, 80%);
    justify-self: center;
    margin-bottom: 28px;
  }
  .hero-portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 32px 32px 32px 96px;
    box-shadow: var(--shadow-xl);
  }
  .now {
    position: absolute;
    z-index: 2;
    left: -16px;
    bottom: -28px;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 300px;
    padding: 14px 18px 14px 14px;
    background: var(--color-card-solid);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    line-height: 1.35;
  }
  .now-text {
    display: grid;
  }
  .now strong {
    font-family: var(--font-heading);
    font-size: 1rem;
  }
  .now-text span:last-child {
    color: var(--color-muted-foreground);
    font-size: 0.9rem;
  }
  @media (min-width: 900px) {
    .log-grid {
      grid-template-columns: 1fr 340px;
      align-items: center;
      gap: 72px;
    }
    .hero-portrait {
      width: 100%;
    }
  }
  @media (min-width: 1200px) {
    .log-grid {
      grid-template-columns: 1fr 380px;
    }
  }

  /* Proof points: a bento, the headline number takes the big tile */
  .proof {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: clamp(56px, 8vw, 88px);
  }
  .proof-card {
    display: grid;
    align-content: end;
    gap: 6px;
    padding: 20px;
  }
  .proof-card dt {
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .proof-value {
    order: -1;
    color: var(--color-foreground);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .proof-card:first-child {
    grid-column: 1 / -1;
    color: #ffffff;
    background: var(--green-900);
    border-color: var(--green-900);
  }
  .proof-card:first-child .proof-value {
    color: #ffffff;
    font-size: clamp(3.4rem, 10vw, 5.2rem);
  }
  .proof-card:first-child .label {
    color: #ffffff;
  }
  @media (min-width: 900px) {
    .proof {
      grid-template-columns: 1.6fr 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 16px;
    }
    .proof-card {
      padding: 24px;
    }
    .proof-card:first-child {
      grid-column: 1;
      grid-row: 1 / 3;
    }
  }

  /* 03 Skills */
  .skills {
    display: grid;
    gap: 16px;
  }
  .skill {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: clamp(24px, 3vw, 32px);
  }
  .skill p {
    color: var(--color-muted-foreground);
  }
  .skill .tags {
    margin-top: 4px;
  }
  @media (min-width: 900px) {
    .skills {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  /* 05 Writing */
  .writing {
    background: var(--color-band);
  }
  .writing-grid {
    display: grid;
    gap: 48px 32px;
  }
  .writing-col {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 16px;
  }
  .list-title {
    font-size: 1.1rem;
  }
  .papers,
  .builds {
    display: grid;
    width: 100%;
    gap: 12px;
  }
  .paper {
    display: grid;
    gap: 10px;
    padding-right: 56px;
    cursor: pointer;
  }
  .paper-link {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 1.8vw, 1.3rem);
    font-weight: 700;
    line-height: 1.3;
  }
  .paper-link:focus-visible,
  .build-name:focus-visible {
    outline: none;
  }
  .paper:has(a:focus-visible),
  .build:has(a:focus-visible) {
    outline: 3px solid var(--color-ring);
    outline-offset: 3px;
  }
  .paper-desc {
    color: var(--color-muted-foreground);
  }
  .paper-icon {
    position: absolute;
    top: 24px;
    right: 24px;
    color: var(--color-primary);
  }
  .build {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 20px;
    cursor: pointer;
  }
  .build-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .build .icon-tile {
    width: 40px;
    height: 40px;
  }
  .build-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
  }
  .build-body {
    color: var(--color-muted-foreground);
    font-size: 0.95rem;
  }
  .writing-col > .text-link {
    gap: 8px;
  }
  @media (min-width: 640px) {
    .builds {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .writing-grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  /* 06 Beyond: photo + two cards, then the wedding band */
  .beyond {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .beyond-photo :global(.campus-photo) {
    width: 100%;
    aspect-ratio: 3 / 2;
  }
  .edu,
  .capstone {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 10px;
  }
  .edu h3,
  .capstone h3 {
    font-size: 1.3rem;
  }
  /* Padding keeps the title link a 44px tap target even on one line */
  .capstone h3 a {
    display: inline-block;
    padding-block: 10px;
    transition: color var(--duration) ease;
  }
  .capstone h3 a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .certs {
    display: grid;
    width: 100%;
    gap: 6px;
    margin-block: 4px;
  }
  .certs li {
    display: flex;
    gap: 8px;
    font-size: 0.95rem;
  }
  .certs :global(.icon) {
    margin-top: 4px;
    color: var(--color-primary);
  }
  .capstone-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }
  @media (min-width: 900px) {
    .beyond {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      grid-template-rows: auto auto;
      gap: 20px;
    }
    .beyond-photo {
      grid-row: 1 / 3;
    }
    .beyond-photo :global(.campus-photo) {
      height: 100%;
      min-height: 360px;
      aspect-ratio: auto;
    }
  }

  /* Wedding: full-width photo, text on a scrim on wide screens */
  .wedding {
    position: relative;
    display: grid;
    margin-top: 20px;
    overflow: hidden;
    color: #f1f7ec;
    background: #0a1a09;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }
  .wedding :global(.wedding-photo) {
    aspect-ratio: 3 / 2;
    border-radius: 0;
  }
  .wedding-text {
    display: grid;
    gap: 8px;
    padding: 24px;
  }
  .wedding-text .label,
  .wedding-text p:not(.label) {
    color: #d1e7d8;
  }
  .wedding-text h3 {
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
  }
  @media (min-width: 760px) {
    .wedding :global(.wedding-photo) {
      aspect-ratio: 21 / 10;
    }
    .wedding::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(90deg, rgba(6, 18, 8, 0.88) 0%, rgba(6, 18, 8, 0.55) 45%, rgba(6, 18, 8, 0) 75%);
    }
    .wedding-text {
      position: absolute;
      z-index: 1;
      left: 0;
      bottom: 0;
      max-width: 540px;
      padding: clamp(28px, 4vw, 48px);
      pointer-events: none;
    }
    .wedding :global(.photo-count) {
      z-index: 2;
    }
  }

  /* 07 Contact: a deep green card, fixed colours in both themes */
  .contact-section {
    padding-top: 0;
  }
  .contact {
    position: relative;
    display: grid;
    gap: 32px;
    overflow: hidden;
    padding: clamp(28px, 6vw, 72px);
    color: #ffffff;
    background: var(--green-900);
    border-radius: 32px;
    box-shadow: var(--shadow-xl);
  }
  .contact::before,
  .contact::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .contact::before {
    top: -120px;
    right: -80px;
    width: 340px;
    height: 340px;
    background: rgba(40, 167, 69, 0.3);
  }
  .contact::after {
    bottom: -140px;
    left: 30%;
    width: 280px;
    height: 280px;
    background: rgba(255, 255, 255, 0.06);
  }
  .contact > * {
    position: relative;
    z-index: 1;
  }
  .contact-head,
  .contact-reach {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 20px;
  }
  .contact .eyebrow {
    color: #ffffff;
  }
  .contact .eyebrow b {
    color: var(--green-900);
    background: #ffffff;
  }
  .contact h2 {
    max-width: 16ch;
  }
  .contact-body {
    max-width: 52ch;
