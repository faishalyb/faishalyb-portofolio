---
/**
 * The evidence beside each case study. All of it is real content, not illustration:
 * benchmark bars, the phase comparison, the two apps, and real app screenshots.
 * Bar lengths are SVG attributes because the site's CSP blocks inline style attributes.
 */
import { Image } from 'astro:assets';
import { appScreens } from '../data/photos';
import ticketQr from '../assets/ticket-qr.png';
import { caseStudies } from '../data/site';

interface Props {
  type: 'face' | 'field' | 'harvest' | 'screens';
  /** Larger screenshots on the case study page. */
  large?: boolean;
}
const { type, large = false } = Astro.props;

// True accept rate at FAR 1e-4 and model size, from the LFW table in src/data/site.ts.
const accuracy = [
  { name: 'FaceNet-512', note: 'Phase 1', value: 84.6 },
  { name: 'MobileFaceNet 192-d', note: 'considered', value: 95.6 },
  { name: 'ArcFace MobileFaceNet', note: 'shipped in Phase 2', value: 99.1, chosen: true },
];
const sizes = [
  { name: 'FaceNet-512', value: 47, label: '~47 MB' },
  { name: 'ArcFace MobileFaceNet', value: 6.9, label: '6.9 MB', chosen: true },
];

const phases = caseStudies.find((item) => item.slug === 'do-iam-field-operations')?.tables?.[0];
const phaseRow = (label: string) => phases?.rows.find((row) => row[0] === label) ?? ['', '', ''];
const period = phaseRow('Period');
const fieldData = phaseRow('Field data');
---

{type === 'face' && (
  <figure class="ev ev-chart" data-reveal>
    <figcaption>
      <strong>True accept rate</strong> at 1 false accept in 10,000
    </figcaption>
    <ul class="bars">
      {accuracy.map((row) => (
        <li class:list={{ chosen: row.chosen }}>
          <span class="bar-name">{row.name}<small>{row.note}</small></span>
          <b class="bar-value">{row.value}%</b>
          <svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <rect class="bar-track" width="100" height="8" />
            <rect class="bar-fill" width={row.value} height="8" />
          </svg>
        </li>
      ))}
    </ul>
    <p class="ev-sub"><strong>Model file size</strong></p>
    <ul class="bars bars-size">
      {sizes.map((row) => (
        <li class:list={{ chosen: row.chosen }}>
          <span class="bar-name">{row.name}</span>
          <b class="bar-value">{row.label}</b>
          <svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <rect class="bar-track" width="100" height="8" />
            <rect class="bar-fill" width={(row.value / 47) * 100} height="8" />
          </svg>
        </li>
      ))}
    </ul>
    <p class="label ev-source">Accuracy: LFW benchmark, not field data. <span class="note-size">Size: model file.</span> Bars start at zero.</p>
  </figure>
)}

{type === 'field' && (
  <figure class="ev ev-phases" data-field>
    <figcaption class="sr-only">How field data moved from NFC tags in Phase 1 to printed tickets in Phase 2</figcaption>
    <div class="phase">
      <p class="label">Phase 1 · {period[1]}</p>
      <!-- A tag tapped to the phone. The scroll plays it (src/scripts/field-play.ts); as drawn, it is done. -->
      <svg class="tap" viewBox="0 0 160 128" aria-hidden="true">
        <g class="tap-tag">
          <rect x="38" y="40" width="48" height="32" rx="5" />
          <path d="M49 51q3 5 0 10M54 48q5 8 0 16M59 45q7 11 0 22" />
        </g>
        <g class="tap-waves">
          <path d="M30.1 44.4A34 34 0 0 1 50.4 24.1" />
          <path d="M22.5 41.6A42 42 0 0 1 47.6 16.5" />
          <path d="M15 38.9A50 50 0 0 1 44.9 9" />
        </g>
        <rect class="tap-body" x="78" y="12" width="56" height="110" rx="11" />
        <rect class="tap-screen" x="83" y="22" width="46" height="88" rx="4" />
        <path class="tap-speaker" d="M100 17h12" />
        <g class="tap-idle">
          <path d="M98.2 54.2a2.9 2.9 0 0 1 2.9-2.9h9.8a2.9 2.9 0 0 1 2.9 2.9v9.8a2.9 2.9 0 0 1-2.9 2.9h-9.8a2.9 2.9 0 0 1-2.9-2.9zM103 55.4q2 3 0 7.2M106.6 53.6q3 5 0 10.8" />
          <rect x="94" y="78" width="24" height="4" rx="2" />
        </g>
        <g class="tap-done">
          <g class="tap-check">
            <circle cx="106" cy="52" r="12" />
            <path d="M100.5 52.5l3.8 3.8 7.2-7.6" />
          </g>
          <rect class="tap-row" x="92" y="74" width="28" height="4" rx="2" />
          <rect x="92" y="83" width="22" height="4" rx="2" />
          <rect x="92" y="92" width="26" height="4" rx="2" />
        </g>
      </svg>
      <p class="phase-what">{fieldData[1]}</p>
    </div>
    <div class="phase phase-now">
      <p class="label">Phase 2 · {period[2]}</p>
      <!-- The ticket comes out of the printer's mouth, top line first, as the scroll plays it -->
      <div class="print" aria-hidden="true">
        <div class="feed">
          <div class="ticket">
            <b>DO! IAM · HARVEST</b>
            <span>BLOCK ····· A01</span>
            <span>BUNCHES ···· 84</span>
            <span>LOOSE ··· 12 kg</span>
            <Image class="ticket-qr" src={ticketQr} alt="" width={176} />
          </div>
        </div>
        <svg class="printer" viewBox="0 0 240 34">
          <rect class="printer-body" x="1" y="5" width="238" height="28" rx="9" />
          <rect class="printer-mouth" x="12" y="1" width="216" height="9" rx="4.5" />
          <rect class="printer-key" x="22" y="17" width="24" height="8" rx="4" />
          <path class="printer-bt" d="M193 15.5l7 6.5-3.5 3.5V12.5l3.5 3.5-7 6.5" />
          <circle class="printer-led" cx="214" cy="21" r="3.5" />
        </svg>
      </div>
      <p class="phase-what">{fieldData[2]}</p>
      <p class="label ev-source">Ticket drawing uses sample values, not field data.</p>
    </div>
  </figure>
)}

{type === 'harvest' && (
  <div class="ev ev-apps">
    <div class="app">
      <p class="app-name">ePMS</p>
      <p>Planning, harvest and inspection for estate staff, with NFC data capture.</p>
      <p class="label">For estate staff</p>
    </div>
    <div class="app">
      <p class="app-name">eTis</p>
      <p>Harvest order tickets for plasma and external growers selling fruit to ANJ.</p>
      <p class="label">For external growers · public on Google Play</p>
    </div>
  </div>
)}

{type === 'screens' && (
  <div class:list={['ev', 'ev-screens', { large }]}>
    {appScreens.map((shot, i) => (
      <Image
        class={`screen screen-${i + 1}`}
        src={shot.src}
        alt={shot.alt}
        widths={[240, 360, 480, 640]}
        sizes={large ? '(max-width: 700px) 30vw, 280px' : '(max-width: 700px) 30vw, 220px'}
      />
    ))}
  </div>
)}

<script>
  import { reducedMotion, scrub } from '../scripts/scrub';
  import { fieldPlayer } from '../scripts/field-play';

  // The field phases play as they pass up the screen. In the work reel, WorkReel.astro plays them instead.
  if (!reducedMotion.matches) {
    for (const figure of document.querySelectorAll<HTMLElement>('[data-field]')) {
      if (figure.closest('[data-reel]')) continue;
      const player = fieldPlayer(figure);
      scrub(player.passing, player.render);
    }
  }
</script>

<style>
  .ev {
    display: grid;
    width: 100%;
    height: 100%;
    align-content: center;
  }
  /* Two-column layouts below key off the wrapper's width (it sets container-type) */
  .ev-source {
    color: var(--color-muted-foreground);
  }

  /* Benchmark bars: the shipped model is the green bar, the rest stay neutral */
  .ev-chart {
    gap: 16px;
  }
  .ev-chart figcaption,
  .ev-sub {
    color: var(--color-muted-foreground);
    font-size: 0.95rem;
  }
  .ev-chart strong {
    color: var(--color-foreground);
    font-family: var(--font-heading);
    font-weight: 600;
  }
  .ev-sub {
    margin-top: 4px;
  }
  .bars {
    display: grid;
    gap: 14px;
  }
  .bars li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 6px 16px;
  }
  .bar-name {
    display: grid;
    font-weight: 600;
    line-height: 1.3;
  }
  .bar-name small {
    color: var(--color-muted-foreground);
    font-size: 0.85rem;
    font-weight: 400;
  }
  .bar-value {
    font-family: var(--font-heading);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .chosen .bar-value {
    color: var(--color-primary);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .bar {
    grid-column: 1 / -1;
    width: 100%;
    height: 12px;
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .bar-track {
    fill: var(--color-muted);
  }
  .bar-fill {
    fill: color-mix(in srgb, var(--color-muted-foreground) 55%, var(--color-muted));
    transform-box: fill-box;
    transform-origin: left center;
  }
  .chosen .bar-fill {
    fill: var(--color-primary);
  }
  .bars-size .bar {
    height: 8px;
  }
  /* Bars grow from zero once, when the chart enters view (plain ease-out: this is data) */
  :global(.has-js) .ev-chart .bar-fill {
    transform: scaleX(0);
    transition: transform 900ms var(--ease-out) 200ms;
  }
  :global(.has-js) .ev-chart:global(.is-visible) .bar-fill {
    transform: none;
  }
  :global(.has-js) .ev-chart:global([data-reveal]) {
    opacity: 1;
    transform: none;
  }

  /* Phase comparison */
  .ev-phases {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .phase {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 18px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .phase-now {
    border: 2px solid var(--color-primary);
  }
  .phase-what {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.35;
  }
  /*
   * Phase 1: an NFC tag tapped to a phone. The scroll sets --tap (tag moves in) and --read
   * (signal rings, the screen shows the record); the defaults here are the finished state.
   */
  .ev-phases {
    --tap: 1;
    --read: 1;
    --feed: 1;
    --busy: 0;
  }
  .tap {
    display: block;
    width: 100%;
    max-width: 200px;
    height: auto;
    overflow: visible;
  }
  .tap-tag {
    transform: translate(calc((1 - var(--tap)) * -24px), calc((1 - var(--tap)) * 36px))
      rotate(calc((1 - var(--tap)) * -18deg));
    transform-box: fill-box;
    transform-origin: center;
  }
  .tap-tag rect {
    fill: var(--device-tag);
    stroke: var(--device-line);
    stroke-width: 1.5;
  }
  .tap-tag path,
  .tap-waves path {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 2.6;
    stroke-linecap: round;
  }
  /* The rings come out one after another */
  .tap-waves path {
    opacity: clamp(0, calc(var(--read) * 3 - var(--i, 0)), 1);
  }
  .tap-waves path:nth-child(2) {
    --i: 1;
  }
  .tap-waves path:nth-child(3) {
    --i: 2;
  }
  .tap-body {
    fill: var(--device-body);
    stroke: var(--device-edge);
    stroke-width: 1.5;
  }
  .tap-screen {
    fill: var(--device-screen);
  }
  .tap-speaker {
    stroke: var(--device-edge);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .tap-idle {
    opacity: calc(1 - var(--read));
  }
  .tap-idle path {
    fill: none;
    stroke: var(--color-muted-foreground);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .tap-idle rect,
  .tap-done rect {
    fill: var(--device-line);
  }
  .tap-done {
    opacity: var(--read);
  }
  .tap-check {
    transform: scale(calc(0.5 + 0.5 * var(--read)));
    transform-box: fill-box;
    transform-origin: center;
  }
  .tap-check circle {
    fill: var(--color-accent);
  }
  .tap-check path {
    fill: none;
    stroke: var(--color-on-accent);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tap-done .tap-row {
    fill: var(--color-primary);
  }

  /*
   * Phase 2: a Bluetooth thermal printer. The ticket sits in a frame that ends at the printer's
   * mouth and is clipped there, so --feed slides it up out of the printer. A lip of paper shows
   * before printing starts.
   */
  .print {
    display: grid;
    justify-items: center;
    width: min(260px, 100%);
  }
  .feed {
    width: calc(100% - 40px);
    margin-bottom: -5px;
    clip-path: inset(-24px -24px 0 -24px);
  }
  .feed .ticket {
    transform: translateY(calc((1 - var(--feed)) * 96%));
  }
  .printer {
    position: relative; /* paints over the ticket, which is transformed */
    display: block;
    width: 100%;
    height: auto;
  }
  .printer-body {
    fill: var(--device-body);
    stroke: var(--device-edge);
    stroke-width: 1.5;
  }
  .printer-mouth {
    fill: var(--device-slot);
    stroke: var(--device-edge);
    stroke-width: 1;
  }
  .printer-key {
    fill: var(--device-edge);
  }
  .printer-bt {
    fill: none;
    stroke: var(--device-glyph);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: calc(0.45 + 0.55 * var(--busy));
  }
  .printer-led {
    fill: var(--color-secondary);
    opacity: calc(0.35 + 0.65 * var(--busy));
  }

  /* A drawn paper ticket, so it keeps paper colours in both themes */
  .ticket {
    display: grid;
    width: 100%;
    gap: 2px;
    padding: 14px 16px 18px;
    color: #1b1d18;
    background: #fbfaf5;
    border: 1px solid rgba(31, 52, 12, 0.16);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    box-shadow: var(--shadow-lg);
    font-family: var(--font-code);
    font-size: 0.82rem;
    line-height: 1.5;
    white-space: pre;
  }
  .ticket b {
    margin-bottom: 6px;
    font-weight: 600;
  }
  /* QR code printed at the foot of the ticket (the real tickets carry a QR, not a barcode) */
  .ticket-qr {
    justify-self: center;
    width: 88px;
    height: auto;
    margin-top: 10px;
    image-rendering: pixelated;
    mix-blend-mode: multiply; /* the QR's white sits into the paper colour */
  }
  @container (min-width: 440px) {
    .ev-phases {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  /* Two apps */
  .ev-apps {
    gap: 12px;
  }
  .app {
    display: grid;
    gap: 6px;
    padding: 20px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .app-name {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  @container (min-width: 440px) {
    .ev-apps {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Screenshots: phones lie on top of the panel, so they carry the shadow */
  .ev-screens {
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    gap: clamp(8px, 2vw, 18px);
    max-width: 640px;
    margin-inline: auto;
  }
  .ev-screens.large {
    max-width: 860px;
  }
  .screen {
    width: 100%;
    filter: drop-shadow(0 16px 20px rgba(31, 52, 12, 0.25));
  }
  .screen-2 {
    transform: translateY(-6%);
  }

  /*
   * In the pinned work reel (WorkReel.astro) every card has to fit one screen, so the evidence
   * is trimmed: the accuracy bars without the size chart, and a tighter phase comparison.
   */
  :global(.is-pinned) .ev-chart {
    gap: 12px;
  }
  :global(.is-pinned) .ev-sub,
  :global(.is-pinned) .bars-size,
  :global(.is-pinned) .note-size {
    display: none;
  }
  :global(.is-pinned) .bars {
    gap: 10px;
  }
  :global(.is-pinned) .ev-phases {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 10px;
  }
  :global(.is-pinned) .phase {
    gap: 8px;
    padding: 12px;
  }
  :global(.is-pinned) .phase-what {
    font-size: 0.92rem;
  }
  :global(.is-pinned) .ticket {
    padding: 10px 12px 12px;
    font-size: 0.74rem;
  }
  :global(.is-pinned) .ticket-qr {
    width: 46px;
    margin-top: 6px;
  }
  :global(.is-pinned) .app {
    padding: 16px;
  }
  :global(.is-pinned) .app-name {
    font-size: 2rem;
  }
  :global(.is-pinned) .ev-screens {
    max-width: 380px;
  }
</style>
