---
/**
 * The identity motif: a phone signal meter with all four bars empty ("no signal").
 * Used only where the no-signal idea is spoken (hero headline, contact heading).
 * Decorative: the words next to it already say it.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['signal-meter', className]} viewBox="0 0 44 36" aria-hidden="true" focusable="false">
  <rect x="2" y="25" width="7" height="9" />
  <rect x="13" y="18" width="7" height="16" />
  <rect x="24" y="10" width="7" height="24" />
  <rect x="35" y="2" width="7" height="32" />
</svg>

<style>
  .signal-meter {
    display: inline-block;
    width: 0.82em;
    height: auto;
    overflow: visible;
    vertical-align: baseline;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
  }
</style>
