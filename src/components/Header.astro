---
import Icon from './Icon.astro';
import { profile } from '../data/site';

const isHome = Astro.url.pathname === '/';
const nav = [
  { label: 'Work', id: 'work' },
  { label: 'Journey', id: 'journey' },
  { label: 'Publications', id: 'publications' },
  { label: 'Contact', id: 'contact' },
].map((item) => ({ label: item.label, href: `${isHome ? '' : '/'}#${item.id}` }));
---

<header class="site-header" data-header>
  <div class="header-inner shell">
    <a class="brand" href="/">{profile.name}</a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <button class="icon-btn" type="button" aria-label="Switch to dark theme" aria-pressed="false" title="Switch to dark theme" data-theme-toggle>
        <span class="theme-icon theme-icon-moon"><Icon name="moon" size={19} /></span>
        <span class="theme-icon theme-icon-sun"><Icon name="sun" size={19} /></span>
      </button>
      <button class="icon-btn nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>
        <span class="nav-open"><Icon name="menu" /></span>
        <span class="nav-close"><Icon name="close" /></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" data-mobile-nav inert>
    <div class="shell">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </nav>
</header>

<script>
  const setupHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');
    if (!header || !toggle || !mobileNav || toggle.dataset.ready) return;
    toggle.dataset.ready = 'true';

    const close = () => {
      header.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation');
      mobileNav.inert = true;
    };

    toggle.addEventListener('click', () => {
      if (header.classList.contains('menu-open')) {
        close();
        return;
      }
      header.classList.add('menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close navigation');
      mobileNav.inert = false;
      requestAnimationFrame(() => mobileNav.querySelector<HTMLAnchorElement>('a')?.focus());
    });

    mobileNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !header.classList.contains('menu-open')) return;
      close();
      toggle.focus();
    });
    window.addEventListener('resize', () => { if (window.innerWidth > 820) close(); }, { passive: true });
  };
  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>

<script>
  const setupThemeToggle = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]:not([data-theme-ready])').forEach((toggle) => {
      toggle.dataset.themeReady = 'true';

      const updateLabel = () => {
        const isDark = document.documentElement.dataset.theme === 'dark';
        const label = isDark ? 'Switch to light theme' : 'Switch to dark theme';
        toggle.setAttribute('aria-label', label);
        toggle.setAttribute('title', label);
        toggle.setAttribute('aria-pressed', String(isDark));
        document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
          meta.setAttribute('content', isDark ? '#111016' : '#f5f0e8');
        });
      };

      toggle.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        try { localStorage.setItem('theme', nextTheme); } catch {}
        updateLabel();
      });

      updateLabel();
    });
  };

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    min-height: var(--header);
    align-items: center;
    gap: 20px;
  }
  .brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-right: auto;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brand:hover {
    color: var(--green);
  }
  .desktop-nav {
    display: flex;
    gap: 4px;
  }
  .desktop-nav a,
  .mobile-nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 12px;
    border-radius: var(--radius-s);
    font-weight: 600;
  }
  .desktop-nav a:hover,
  .mobile-nav a:hover {
    background: var(--paper-deep);
  }
  .desktop-nav a:active,
  .mobile-nav a:active {
    color: var(--green);
  }
  .header-actions {
    display: flex;
    gap: 8px;
  }
  /* Icon-only buttons are the one round control (DESIGN.md, Shape) */
  .icon-btn {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .icon-btn:hover {
    background: var(--paper-deep);
    border-color: var(--ink);
  }
  .icon-btn:active {
    background: var(--line);
  }
  .theme-icon-sun,
  :global([data-theme='dark']) .theme-icon-moon,
  .nav-close,
  .menu-open .nav-open {
    display: none;
  }
  :global([data-theme='dark']) .theme-icon-sun,
  .menu-open .nav-close {
    display: block;
  }
  .nav-toggle,
  .mobile-nav {
    display: none;
  }
  @media (max-width: 820px) {
    .desktop-nav {
      display: none;
    }
    .nav-toggle {
      display: grid;
    }
    .menu-open .mobile-nav {
      display: block;
      padding: 8px 0 16px;
      border-top: 1px solid var(--line);
    }
    .mobile-nav .shell {
      display: grid;
    }
    .mobile-nav a {
      min-height: 52px;
      font-size: 1.1rem;
    }
  }
</style>
