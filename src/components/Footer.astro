---
import Icon from './Icon.astro';
import { profile, socialLinks, template } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <hr class="tear shell" />
  <div class="shell footer-main">
    <p class="footer-line"><strong>{profile.name}</strong><br />Apps that work offline. Showing the evidence.</p>
    <nav class="footer-links" aria-label="Elsewhere">
      {socialLinks.map((link) => (
        <a class="text-link" href={link.href} target="_blank" rel="noreferrer">{link.label} <Icon name="arrow-up-right" size={15} /></a>
      ))}
      <a class="text-link" href={`mailto:${profile.email}`}>Email</a>
    </nav>
  </div>
  <div class="shell footer-bottom">
    <span>© {year} {profile.name}</span>
    <a class="footer-small" href={template.creatorUrl} target="_blank" rel="noreferrer">Built on {template.name} by {template.creator}</a>
    <a class="footer-small" href="#top">Back to top</a>
  </div>
</footer>

<style>
  .site-footer {
    padding-bottom: 28px;
  }
  .footer-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 40px;
    padding-block: 36px 20px;
  }
  .footer-line {
    color: var(--muted);
  }
  .footer-line strong {
    color: var(--ink);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 22px;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .footer-bottom span {
    margin-right: auto;
  }
  .footer-small {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-small:hover {
    color: var(--ink);
  }
  .footer-small:active {
    color: var(--green);
  }
</style>
