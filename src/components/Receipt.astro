---
/**
 * The hero receipt: how one face check runs in DO! IAM, printed like a field ticket (DESIGN.md, Motif).
 * The mode buttons switch the threshold line. Values come from src/data/site.ts.
 */
import { faceCheck } from '../data/site';

const [first] = faceCheck.modes;
---

<figure class="receipt" data-receipt>
  <figcaption>
    <strong>DO! IAM · face check</strong>
    <span>How one check runs: on the phone, with no network.</span>
  </figcaption>

  <div class="receipt-modes" role="group" aria-label="Kind of face check">
    {faceCheck.modes.map((mode, index) => (
      <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-threshold={mode.threshold} data-rule={mode.rule}>
        {mode.label}
      </button>
    ))}
  </div>

  <dl>
    {faceCheck.steps.map((step, index) => (
      <div><dt>0{index + 1} {step.name}</dt><dd>{step.detail}</dd></div>
    ))}
    <div class="receipt-mode-line" aria-live="polite">
      <dt>Threshold</dt>
      <dd><b data-receipt-threshold>{first.threshold}</b> cosine, <span data-receipt-rule>{first.rule}</span></dd>
    </div>
    {faceCheck.facts.map((fact) => (
      <div><dt>{fact.name}</dt><dd>{fact.detail}</dd></div>
    ))}
  </dl>

  <p class="receipt-total">
    <span>{faceCheck.total.label}</span>
    <strong>{faceCheck.total.value}</strong>
    <small>{faceCheck.total.source}</small>
  </p>
</figure>

<script>
  const setupReceipt = () => {
    document.querySelectorAll<HTMLElement>('[data-receipt]:not([data-ready])').forEach((receipt) => {
      receipt.dataset.ready = 'true';
      const buttons = [...receipt.querySelectorAll<HTMLButtonElement>('button[data-threshold]')];
      const threshold = receipt.querySelector<HTMLElement>('[data-receipt-threshold]');
      const rule = receipt.querySelector<HTMLElement>('[data-receipt-rule]');
      if (!threshold || !rule) return;
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
          threshold.textContent = button.dataset.threshold ?? '';
          rule.textContent = button.dataset.rule ?? '';
        });
      });
    });
  };
  setupReceipt();
  document.addEventListener('astro:page-load', setupReceipt);
</script>

<style>
  .receipt {
    position: relative;
    max-width: 440px;
    margin-inline: auto;
    padding: 26px 24px 30px;
    color: var(--receipt-ink);
    background: var(--receipt);
    border-radius: 4px 4px 0 0;
    box-shadow: var(--lift);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.5;
  }
  /* Perforated bottom edge: the slip was torn off a printer roll */
  .receipt::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -9px;
    left: 0;
    height: 9px;
    background: radial-gradient(circle at 6px -1px, transparent 6px, var(--receipt) 6.5px) repeat-x;
    background-size: 12px 9px;
  }
  figcaption {
    display: grid;
    gap: 4px;
    padding-bottom: 14px;
    border-bottom: 2px dashed var(--receipt-muted);
  }
  figcaption strong {
    font-size: 0.95rem;
  }
  figcaption span {
    color: var(--receipt-muted);
  }
  .receipt-modes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .receipt-modes button {
    min-height: 44px;
    padding: 0 11px;
    color: var(--receipt-ink);
    background: none;
    border: 1px solid var(--receipt-muted);
    border-radius: var(--radius-s);
    font-size: 0.8rem;
    transition: background-color 140ms ease;
  }
  .receipt-modes button:hover {
    background: rgba(29, 27, 23, 0.08);
  }
  .receipt-modes button:active {
    background: rgba(29, 27, 23, 0.16);
  }
  .receipt-modes button[aria-pressed='true'] {
    color: var(--receipt);
    background: var(--receipt-ink);
    border-color: var(--receipt-ink);
  }
  .receipt-modes button:focus-visible {
    outline-color: var(--receipt-green);
  }
  dl {
    display: grid;
    gap: 7px;
    margin-top: 16px;
  }
  dl > div {
    display: grid;
    grid-template-columns: 12ch 1fr;
    gap: 12px;
  }
  dt {
    color: var(--receipt-muted);
  }
  .receipt-mode-line {
    margin-block: 5px;
    padding-block: 9px;
    border-block: 1px dashed var(--receipt-muted);
  }
  .receipt-mode-line b {
    font-size: 1.05rem;
  }
  .receipt-total {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2px 12px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 2px dashed var(--receipt-muted);
  }
  .receipt-total strong {
    grid-row: span 2;
    color: var(--receipt-green);
    font-family: var(--font-sans);
    font-size: 2.6rem;
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .receipt-total small {
    color: var(--receipt-muted);
    font-size: 0.78rem;
  }
  /* Objects that lie on the page are turned a little, like a slip dropped on a desk */
  @media (min-width: 960px) {
    .receipt {
      transform: rotate(1.4deg);
    }
  }
  @media (max-width: 400px) {
    .receipt {
      padding-inline: 18px;
    }
    dl > div {
      grid-template-columns: 11ch 1fr;
      gap: 10px;
    }
  }
</style>
