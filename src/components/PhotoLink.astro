---
/**
 * A photo that opens in the viewer (Viewer.astro). Photos that share a `group` can be paged through.
 * The link points at the large file, so it still opens without JavaScript.
 */
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../data/photos';
import Icon from './Icon.astro';

interface Props {
  photo: Photo;
  group: string;
  sizes?: string;
  widths?: number[];
  /** Only in the viewer, not drawn on the page. */
  viewerOnly?: boolean;
  /** Number of photos in the group, shown as a corner tag when above 1. */
  count?: number;
  priority?: boolean;
  class?: string;
}

const { photo, group, sizes = '100vw', widths = [400, 640, 960, 1280], viewerOnly = false, count = 0, priority = false, class: className } = Astro.props;

const full = await getImage({ src: photo.src, width: Math.min(1800, photo.src.width), format: 'webp', quality: 82 });
const data = {
  'data-viewer': group,
  'data-caption': photo.caption,
  'data-alt': photo.alt,
  'data-w': full.attributes.width,
  'data-h': full.attributes.height,
};
---

{viewerOnly ? (
  <a href={full.src} hidden tabindex="-1" {...data}></a>
) : (
  <a class:list={['photo-link', className]} href={full.src} {...data}>
    <Image src={photo.src} alt={photo.alt} widths={widths} sizes={sizes} priority={priority} class="photo-img" />
    {count > 1 && <span class="photo-count" aria-hidden="true"><Icon name="images" size={16} />{count} photos</span>}
    <span class="sr-only">{count > 1 ? `, opens a viewer with ${count} photos` : ', opens the photo viewer'}</span>
  </a>
)}

<style>
  .photo-link {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--color-muted);
    border-radius: var(--radius-xl);
  }
  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease-out);
  }
  .photo-link:hover .photo-img {
    transform: scale(1.03);
  }
  .photo-count {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    color: #336c01;
    background: rgba(255, 255, 255, 0.94);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>
