---
/**
 * How a face check runs in DO! IAM, from src/data/site.ts (faceCheck). The three modes are tabs.
 * Without JavaScript the tab row stays hidden and all three modes are listed one after another.
 */
import { faceCheck } from '../data/site';

interface Props {
  index?: string;
}
const { index = '02' } = Astro.props;
---

<section class="fc section" id="face-check" aria-labelledby="fc-title">
  <div class="shell">
    <header class="sec-head" data-reveal>
      <p class="eyebrow"><b>{index}</b> Inside a face check</p>
      <h2 id="fc-title">Four steps on the phone. No network in the loop.</h2>
      <p>This is the check DO! IAM runs when a plantation worker checks in for the day. Every step runs on a low-end Android phone, so it works in the middle of an estate with no signal.</p>
    </header>

    <ol class="fc-steps" data-stagger>
      {faceCheck.steps.map((step, i) => (
        <li class="card">
          <span class="fc-step-num num" aria-hidden="true">{i + 1}</span>
          <span class="sr-only">Step {i + 1}:</span>
          <strong>{step.name}</strong>
          <span class="fc-detail">{step.detail}</span>
        </li>
      ))}
    </ol>

    <div class="fc-grid">
      <div class="card fc-modes" data-reveal data-tabs>
        <p class="label">Match threshold by mode</p>
        <div class="fc-tabs" role="tablist" aria-label="Face check modes" hidden data-tablist>
          {faceCheck.modes.map((mode, i) => (
            <button
              type="button"
              role="tab"
              id={`fc-tab-${mode.id}`}
              aria-controls={`fc-panel-${mode.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {mode.label}
            </button>
          ))}
        </div>
        {faceCheck.modes.map((mode) => (
          <div class="fc-panel" role="tabpanel" id={`fc-panel-${mode.id}`} aria-labelledby={`fc-tab-${mode.id}`} data-panel>
            <p class="fc-panel-name">{mode.label}</p>
            <p class="fc-threshold"><b class="num">{mode.threshold}</b><span class="label">cosine similarity threshold</span></p>
            <p class="fc-rule">Rule: {mode.rule}.</p>
          </div>
        ))}
      </div>

      <div class="card fc-facts-card" data-reveal>
        <dl class="fc-facts">
          {faceCheck.facts.map((fact) => (
            <div><dt class="label">{fact.name}</dt><dd>{fact.detail}</dd></div>
          ))}
        </dl>
        <div class="fc-total">
          <p class="label">{faceCheck.total.label}</p>
          <p class="fc-total-value num">{faceCheck.total.value}</p>
          <p class="label">{faceCheck.total.source}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tablist = root.querySelector<HTMLElement>('[data-tablist]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    if (!tablist || !tabs.length) return;

    const select = (i: number, focus = false) => {
      tabs.forEach((tab, n) => {
        tab.setAttribute('aria-selected', String(n === i));
        tab.tabIndex = n === i ? 0 : -1;
      });
      panels.forEach((panel, n) => (panel.hidden = n !== i));
      if (focus) tabs[i].focus();
    };

    tablist.hidden = false;
    root.classList.add('is-tabbed');
    select(0);
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const moves: Record<string, number> = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last };
        if (event.key in moves) {
          event.preventDefault();
          select(moves[event.key], true);
        }
      });
    });
  });
</script>

<style>
  .fc {
    background: var(--color-band);
  }

  .fc-steps {
    display: grid;
    gap: 12px;
    margin-bottom: 16px;
  }
  .fc-steps li {
    display: grid;
    grid-template-columns: 48px 1fr;
    align-items: start;
    gap: 4px 16px;
  }
  .fc-step-num {
    grid-row: span 2;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .fc-steps strong {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .fc-detail {
    color: var(--color-muted-foreground);
  }
  @media (min-width: 640px) {
    .fc-steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .fc-steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .fc-steps li {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .fc-step-num {
      grid-row: auto;
      margin-bottom: 6px;
    }
  }

  .fc-grid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 900px) {
    .fc-grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .fc-modes {
    display: grid;
    align-content: start;
    gap: 16px;
  }
  /* Segmented control */
  .fc-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    background: var(--color-muted);
    border-radius: var(--radius-lg);
  }
  .fc-tabs button {
    flex: 1 1 auto;
    min-height: 44px;
    padding: 8px 16px;
    color: var(--color-muted-foreground);
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: 600;
    transition:
      background-color var(--duration) ease,
      color var(--duration) ease,
      box-shadow var(--duration) ease;
  }
  .fc-tabs button:hover {
    color: var(--color-foreground);
  }
  .fc-tabs button[aria-selected='true'] {
    color: var(--color-on-primary);
    background: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }
  .fc-panel {
    display: grid;
    gap: 8px;
  }
  .is-tabbed .fc-panel-name {
    display: none;
  }
  .fc-panel-name {
    font-family: var(--font-heading);
    font-weight: 600;
  }
  .fc-panel + .fc-panel {
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }
  .is-tabbed .fc-panel + .fc-panel {
    padding-top: 0;
    border-top: 0;
  }
  .fc-threshold {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
  }
  .fc-threshold b {
    color: var(--color-primary);
    font-size: clamp(3.6rem, 10vw, 5.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .fc-rule {
    color: var(--color-muted-foreground);
    font-size: 1.05rem;
  }

  .fc-facts-card {
    display: grid;
    align-content: start;
    gap: 20px;
  }
  .fc-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .fc-facts dd {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .fc-total {
    display: grid;
    gap: 4px;
    padding: 20px;
    background: var(--color-primary-soft);
    border-radius: var(--radius-lg);
  }
  .fc-total-value {
    color: var(--color-primary);
    font-size: clamp(2.8rem, 7vw, 3.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
</style>
