---
/**
 * 04 Experience, as a trail: the stops run oldest to newest and a route line inks itself
 * between them as the page scrolls, the way a recorded GPS track grows. A readout shows the
 * year the line has reached.
 *
 * The script measures the stop markers and draws the path through them, so the line follows
 * the real layout at every width. Without JavaScript the stops are joined by a plain line.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import PhotoLink from './PhotoLink.astro';
import { logos, researchPhotos } from '../data/photos';
import { experience, pageCopy, profile } from '../data/site';

const months = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
/** "Jun 2022 – Sep 2024" → the start as a number that sorts by date, and its year. */
const started = (roles: { dates: string }[]) => {
  const [month, year] = roles[roles.length - 1].dates.split(' – ')[0].split(' ');
  return { order: Number(year) * 12 + months.indexOf(month.toLowerCase()), year: Number(year) };
};
// "Sep 2025 – Present" for a company with several roles: start of the oldest, end of the newest.
const span = (roles: { dates: string }[]) => {
  const start = roles[roles.length - 1].dates.split(' – ')[0];
  const end = roles[0].dates.split(' – ')[1] ?? '';
  return end ? `${start} – ${end}` : start;
};

const stops = experience
  .map((job) => ({ job, ...started(job.roles) }))
  .sort((a, b) => a.order - b.order);
const thisYear = new Date().getFullYear();
---

<section class="section journey" id="experience" aria-labelledby="exp-title">
  <div class="shell">
    <header class="sec-head" data-reveal>
      <p class="eyebrow"><b>04</b> Experience</p>
      <h2 id="exp-title">From a network lab to the plantation field.</h2>
      <p>{pageCopy.journeyIntro}</p>
    </header>

    <div class="trail" data-trail>
      <svg class="trail-map" data-trail-map aria-hidden="true" focusable="false">
        <path class="trail-plan" data-trail-plan />
        <path class="trail-ink" data-trail-ink />
        <circle class="trail-head-glow" data-trail-head r="11" />
        <circle class="trail-head" data-trail-head r="5" />
      </svg>

      <p class="readout" aria-hidden="true">
        <span class="label">On the trail</span>
        <b class="num" data-trail-year>{thisYear}</b>
        <span class="label num"><span data-trail-count>{stops.length}</span> of {stops.length} stops</span>
      </p>

      <ol class="stops">
        {stops.map(({ job, year }) => (
          <li class="stop" data-stop data-year={year}>
            <span class="stop-dot" data-stop-dot aria-hidden="true"></span>
            <article class="card job-card" data-reveal>
              <div class="job-head">
                <span class="job-logo">
                  {job.logo ? <Image src={logos[job.logo]} alt="" width={112} height={112} /> : <span aria-hidden="true">{job.marker}</span>}
                </span>
                <div class="job-org">
                  <h3>{job.company}</h3>
                  <p class="job-place">{job.location}</p>
                </div>
                <span class="date-chip num">{span(job.roles)}</span>
              </div>
              <ul class="job-roles">
                {job.roles.map((role) => (
                  <li><strong>{role.title}</strong>{job.roles.length > 1 && <span class="label num">{role.dates}</span>}</li>
                ))}
              </ul>
              <p class="job-note">{job.note}</p>
              {job.gallery === 'research' && (
                <div class="job-photos">
                  {researchPhotos.map((photo) => (
                    <PhotoLink photo={photo} group="research" sizes="(max-width: 760px) 44vw, 220px" widths={[320, 480, 640]} />
                  ))}
                </div>
              )}
              {job.link && (
                <a class="text-link" href={job.link.href} target="_blank" rel="noopener">{job.link.label} <Icon name="out" size={16} /></a>
              )}
            </article>
          </li>
        ))}
        <li class="stop stop-now" data-stop data-year={thisYear}>
          <span class="stop-dot" data-stop-dot aria-hidden="true"></span>
          <p class="now-note"><span class="label">Today · {profile.location}</span><strong>{profile.availability}</strong></p>
        </li>
      </ol>
    </div>
  </div>
</section>

<script>
  import { clamp, reducedMotion, scrub } from '../scripts/scrub';

  const trail = document.querySelector<HTMLElement>('[data-trail]');
  const map = trail?.querySelector<SVGSVGElement>('[data-trail-map]');
  const plan = trail?.querySelector<SVGPathElement>('[data-trail-plan]');
  const ink = trail?.querySelector<SVGPathElement>('[data-trail-ink]');

  if (trail && map && plan && ink) {
    const heads = Array.from(trail.querySelectorAll<SVGCircleElement>('[data-trail-head]'));
    const stops = Array.from(trail.querySelectorAll<HTMLElement>('[data-stop]'));
    const yearEl = trail.querySelector<HTMLElement>('[data-trail-year]');
    const countEl = trail.querySelector<HTMLElement>('[data-trail-count]');
    const jobs = stops.length - 1; // the last marker is "today", not a job

    type Mark = { el: HTMLElement; x: number; y: number; year: number };
    let marks: Mark[] = [];
    let length = 0;
    // Path length at evenly spaced heights, so a height turns into a length without searching.
    let table: number[] = [];
    let top = 0;
    let bottom = 0;
    let shownYear = '';
    let shownCount = '';

    /** Measure the markers and route the path through them with one S-curve per leg. */
    const route = () => {
      const box = trail.getBoundingClientRect();
      marks = stops.map((el) => {
        const dot = el.querySelector<HTMLElement>('[data-stop-dot]')!.getBoundingClientRect();
        return { el, x: dot.left + dot.width / 2 - box.left, y: dot.top + dot.height / 2 - box.top, year: Number(el.dataset.year) };
      });
      top = 0;
      bottom = marks[marks.length - 1].y;
      let d = `M${marks[0].x.toFixed(1)} ${top}L${marks[0].x.toFixed(1)} ${marks[0].y.toFixed(1)}`;
      for (let i = 1; i < marks.length; i++) {
        const a = marks[i - 1];
        const b = marks[i];
        const mid = ((a.y + b.y) / 2).toFixed(1);
        d += `C${a.x.toFixed(1)} ${mid} ${b.x.toFixed(1)} ${mid} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`;
      }
      plan.setAttribute('d', d);
      ink.setAttribute('d', d);
      length = ink.getTotalLength();
      ink.style.strokeDasharray = `${length.toFixed(1)}`;

      // The path only ever runs downward, so walk it once and note the length at each height.
      const steps = 240;
      table = [];
      let at = 0;
      for (let i = 0; i <= steps; i++) {
        const y = top + ((bottom - top) * i) / steps;
        while (at < length && ink.getPointAtLength(at).y < y) at += length / 1200;
        table.push(Math.min(at, length));
      }
    };

    const draw = (reach: number) => {
      // reach: how far down the trail the line has come, in px from the top of the trail.
      const t = clamp((reach - top) / Math.max(1, bottom - top));
      const slot = t * (table.length - 1);
      const lo = Math.floor(slot);
      const drawn = table[lo] + ((table[Math.min(lo + 1, table.length - 1)] ?? length) - table[lo]) * (slot - lo);
      ink.style.strokeDashoffset = `${(length - drawn).toFixed(1)}`;
      const point = ink.getPointAtLength(drawn);
      heads.forEach((head) => {
        head.setAttribute('cx', point.x.toFixed(1));
        head.setAttribute('cy', point.y.toFixed(1));
      });

      // Markers light up as the line passes; the readout follows.
      let passed = 0;
      let year = marks[0].year;
      marks.forEach((mark, i) => {
        const on = point.y >= mark.y - 2;
        mark.el.classList.toggle('is-reached', on);
        if (!on) return;
        passed = Math.min(i + 1, jobs);
        const next = marks[i + 1];
        const part = next ? clamp((point.y - mark.y) / Math.max(1, next.y - mark.y)) : 0;
        year = Math.floor(mark.year + (next ? (next.year - mark.year) * part : 0));
      });
      const yearText = String(year);
      if (yearEl && yearText !== shownYear) yearEl.textContent = shownYear = yearText;
      const countText = String(passed);
      if (countEl && countText !== shownCount) countEl.textContent = shownCount = countText;
    };

    trail.classList.add('is-live');
    route();
    new ResizeObserver(() => {
      route();
      draw(reducedMotion.matches ? bottom : measure());
    }).observe(trail);

    // The line's tip rides a little below the middle of the screen.
    const measure = () => innerHeight * 0.62 - trail.getBoundingClientRect().top;
    if (reducedMotion.matches) draw(bottom);
    else scrub(measure, draw);
  }
</script>

<style>
  .journey {
    padding-top: 0;
  }
  .trail {
    position: relative;
  }

  /* The route. Drawn by the script; hidden until then, when a plain line stands in. */
  .trail-map {
    position: absolute;
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }
  .is-live .trail-map {
    display: block;
  }
  .trail-plan,
  .trail-ink {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trail-plan {
    stroke: var(--color-border);
    stroke-width: 2;
    stroke-dasharray: 2 9;
  }
  .trail-ink {
    stroke: var(--color-primary);
    stroke-width: 3;
  }
  .trail-head {
    fill: var(--color-primary);
  }
  .trail-head-glow {
    fill: var(--color-secondary);
    opacity: 0.28;
    animation: beat 2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes beat {
    0%,
    100% {
      transform: scale(0.7);
    }
    50% {
      transform: scale(1.25);
    }
  }

  /* Year readout: rides along under the header while the trail is on screen */
  .readout {
    position: sticky;
    z-index: 3;
    top: calc(var(--header) + 12px);
    display: none;
    width: max-content;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 16px auto;
    padding: 6px 14px;
    background: var(--color-card-solid);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    pointer-events: none;
  }
  .is-live .readout {
    display: flex;
  }
  .readout b {
    color: var(--color-primary);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stops {
    position: relative;
    display: grid;
    gap: 20px;
    padding-left: 32px;
  }
  /* Plain line for when the script has not drawn the route */
  .stops::before {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 7px;
    width: 2px;
    background: var(--color-border);
    border-radius: 2px;
  }
  .is-live .stops::before {
    display: none;
  }
  .stop {
    position: relative;
  }
  .stop-dot {
    position: absolute;
    z-index: 2;
    top: 30px;
    left: -32px;
    width: 16px;
    height: 16px;
    background: var(--color-primary);
    border: 4px solid var(--color-primary);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--color-primary-soft);
    transition:
      background-color 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease,
      scale 300ms var(--ease-back);
  }
  /* Until the line arrives a marker is hollow */
  .is-live .stop:not(.is-reached) .stop-dot {
    background: var(--color-card-solid);
    border-color: var(--color-border);
    box-shadow: none;
    scale: 0.8;
  }
  .stop-now .stop-dot {
    top: 8px;
  }
  .now-note {
    display: grid;
    gap: 2px;
    padding-block: 2px 8px;
  }
  .now-note strong {
    font-family: var(--font-heading);
    font-size: 1.1rem;
  }

  .job-card {
    display: grid;
    justify-items: start;
    gap: 14px;
    min-width: 0;
  }
  .job-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    width: 100%;
  }
  .job-logo {
    display: grid;
    flex: none;
    width: 56px;
    height: 56px;
    place-items: center;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: 700;
  }
  .job-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .job-org {
    flex: 1 1 200px;
    min-width: 0;
  }
  .job-place {
    color: var(--color-muted-foreground);
    font-size: 0.95rem;
  }
  .date-chip {
    padding: 4px 12px;
    color: var(--color-foreground);
    background: var(--color-muted);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .job-roles {
    display: grid;
    width: 100%;
    gap: 6px;
  }
  .job-roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
  }
  .job-note {
    max-width: 68ch;
    color: var(--color-muted-foreground);
  }
  /* Every photo the same square tile, two per row */
  .job-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
    gap: 10px;
  }
  .job-photos > :global(.photo-link) {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
  }
  .job-photos > :global(.photo-link) :global(.photo-img) {
    object-position: 50% 40%;
  }
  @media (min-width: 560px) {
    .job-photos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /*
   * Wide screens: the stops alternate left and right of a central lane, and the route
   * switches back across it from one marker to the next.
   */
  @media (min-width: 960px) {
    .stops {
      grid-template-columns: minmax(0, 1fr) 132px minmax(0, 1fr);
      gap: 0;
      padding-left: 0;
    }
    .stops::before {
      left: 50%;
    }
    /* Brick pattern: every stop spans two rows and starts one row below the stop before it */
    .stop {
      grid-column: 1;
      align-self: start;
    }
    .stop:nth-child(even) {
      grid-column: 3;
    }
    .stop:nth-child(1) { grid-row: 1 / span 2; }
    .stop:nth-child(2) { grid-row: 2 / span 2; }
    .stop:nth-child(3) { grid-row: 3 / span 2; }
    .stop:nth-child(4) { grid-row: 4 / span 2; }
    .stop:nth-child(5) { grid-row: 5 / span 2; }
    .stop:nth-child(6) { grid-row: 6 / span 2; }
    .stop:nth-child(7) { grid-row: 7 / span 2; }
    .stop:nth-child(n + 2) {
      padding-top: 40px;
    }
    .stop-dot {
      top: 40px;
      left: auto;
      right: -40px;
    }
    .stop:nth-child(n + 2) .stop-dot {
      top: 80px;
    }
    .stop:nth-child(even) .stop-dot {
      right: auto;
      left: -40px;
    }
    .stop-now.stop-now .stop-dot {
      top: 50px;
    }
    .stop-now:nth-child(odd) .now-note {
      justify-items: end;
      text-align: right;
    }
    .job-card {
      padding: 28px 32px;
    }
    .job-photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* In the lane between the two columns: stacked, so it never covers a card */
    .readout {
      width: 116px;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      margin-inline: auto;
      padding: 10px 8px;
      border-radius: var(--radius-lg);
      text-align: center;
    }
    .readout b {
      font-size: 1.8rem;
    }
  }
  @media (min-width: 1200px) {
    .job-photos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
