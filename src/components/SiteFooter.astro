---
import Icon from './Icon.astro';
import { profile, socialLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell foot">
    <div class="foot-name">
      <strong>{profile.name}</strong>
      <span>{profile.role} · {profile.location}</span>
    </div>
    <ul class="foot-links">
      <li><a href={profile.resume} target="_blank" rel="noopener"><Icon name="download" size={16} />Résumé (PDF)</a></li>
      <li><a href={profile.portfolioPdf} target="_blank" rel="noopener"><Icon name="download" size={16} />Portfolio (PDF)</a></li>
      {socialLinks.map((link) => (
        <li><a href={link.href} target="_blank" rel="noopener"><Icon name={link.icon as 'github' | 'linkedin'} size={16} />{link.label}</a></li>
      ))}
      <li><a href="#top">Back to top</a></li>
    </ul>
    <p class="foot-copy">© {year} {profile.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
  }
  .foot {
    display: grid;
    gap: 20px;
    padding-block: 36px 40px;
  }
  .foot-name {
    display: grid;
    gap: 2px;
  }
  .foot-name strong {
    font-family: var(--font-heading);
    font-size: 1.15rem;
  }
  .foot-name span,
  .foot-copy {
    color: var(--color-muted-foreground);
    font-size: 0.95rem;
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
  }
  .foot-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--color-muted-foreground);
    font-weight: 500;
    transition: color var(--duration) ease;
  }
  .foot-links a:hover {
    color: var(--color-primary);
  }
  @media (min-width: 900px) {
    .foot {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
    .foot-links {
      justify-content: flex-end;
    }
    .foot-copy {
      grid-column: 1 / -1;
    }
  }
</style>
