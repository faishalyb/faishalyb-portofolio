---
/**
 * The evidence shown next to each case study. Each one is real content, not an illustration:
 * a chart of benchmark results, the sample ticket, two app summaries, or real screenshots.
 */
import { Image } from 'astro:assets';
import { appScreens } from '../data/photos';

interface Props {
  type: 'face' | 'field' | 'harvest' | 'screens';
}
const { type } = Astro.props;

// True accept rate at FAR 1e-4 on LFW (same figures as the table on the case study page).
const models = [
  { name: 'FaceNet-512', note: '47 MB, before', value: '84.6%', bar: 'bar-846' },
  { name: 'MobileFaceNet', note: '192-d, considered', value: '95.6%', bar: 'bar-956' },
  { name: 'ArcFace MobileFaceNet', note: '6.9 MB, shipped', value: '99.1%', bar: 'bar-991', chosen: true },
];
---

{type === 'face' && (
  <figure class="visual chart">
    <figcaption>True accept rate at a 1 in 10,000 false accept rate</figcaption>
    <ul>
      {models.map((model) => (
        <li class:list={{ 'is-chosen': model.chosen }}>
          <span class="chart-name">{model.name} <small>{model.note}</small></span>
          <strong>{model.value}</strong>
          <span class={`chart-bar ${model.bar}`}></span>
        </li>
      ))}
    </ul>
    <p class="visual-note">LFW benchmark, bars start at zero.</p>
  </figure>
)}

{type === 'field' && (
  <figure class="visual ticket-wrap">
    <div class="ticket">
      <strong>DO! IAM · HARVEST TICKET</strong>
      <span>TICKET      TP-0000</span>
      <span>BLOCK       A01</span>
      <span>BUNCHES     84</span>
      <span>LOOSE FRUIT 12 kg</span>
      <div class="ticket-bars" aria-hidden="true">{Array.from({ length: 34 }).map(() => <i></i>)}</div>
    </div>
    <figcaption><b>Sample</b> A drawing of the printed ticket with made-up values, not field data.</figcaption>
  </figure>
)}

{type === 'harvest' && (
  <div class="visual apps">
    <dl>
      <div>
        <dt>ePMS</dt>
        <dd>Planning, harvest and inspection for estate staff, with NFC data capture.</dd>
      </div>
      <div>
        <dt>eTis</dt>
        <dd>Harvest order tickets for plasma and external growers. On Google Play.</dd>
      </div>
    </dl>
  </div>
)}

{type === 'screens' && (
  <div class="visual screens">
    {appScreens.map((shot, index) => (
      <Image
        class={`screen screen-${index + 1}`}
        src={shot.src}
        alt={shot.alt}
        widths={[240, 360, 480, 640]}
        sizes="(max-width: 700px) 30vw, 230px"
      />
    ))}
  </div>
)}

<style>
  .visual {
    display: grid;
    width: 100%;
    height: 100%;
    align-content: center;
  }
  figcaption,
  .visual-note {
    color: var(--muted);
    font-size: 0.88rem;
  }

  /* Chart */
  .chart {
    gap: 18px;
  }
  .chart figcaption {
    color: var(--ink);
    font-weight: 650;
  }
  .chart ul {
    display: grid;
    gap: 16px;
  }
  .chart li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 6px 12px;
  }
  .chart-name small {
    display: block;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .chart strong {
    font-family: var(--font-mono);
    font-size: 1rem;
  }
  .chart-bar {
    grid-column: 1 / -1;
    height: 14px;
    background: var(--line-strong);
    border-radius: 3px;
  }
  .is-chosen .chart-bar {
    background: var(--green);
  }
  .is-chosen strong {
    color: var(--green);
    font-size: 1.5rem;
  }
  /* Bar lengths live in the stylesheet: the page's CSP blocks inline style attributes */
  .bar-846 { width: 84.6%; }
  .bar-956 { width: 95.6%; }
  .bar-991 { width: 99.1%; }

  /* Sample ticket */
  .ticket-wrap {
    justify-items: center;
    gap: 26px;
  }
  .ticket {
    position: relative;
    display: grid;
    width: min(270px, 86%);
    gap: 7px;
    padding: 20px 18px 18px;
    color: var(--receipt-ink);
    background: var(--receipt);
    border-radius: 4px 4px 0 0;
    box-shadow: var(--lift);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    transform: rotate(-2deg);
  }
  .ticket::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -9px;
    left: 0;
    height: 9px;
    background: radial-gradient(circle at 6px -1px, transparent 6px, var(--receipt) 6.5px) repeat-x;
    background-size: 12px 9px;
  }
  .ticket strong {
    margin-bottom: 6px;
    padding-bottom: 9px;
    border-bottom: 1px dashed var(--receipt-muted);
  }
  .ticket span {
    white-space: pre;
  }
  .ticket-bars {
    display: flex;
    gap: 2px;
    height: 34px;
    margin-top: 8px;
  }
  .ticket-bars i {
    display: block;
    height: 100%;
    background: var(--receipt-ink);
  }
  .ticket-bars i:nth-child(3n + 1) { width: 1px; }
  .ticket-bars i:nth-child(3n + 2) { width: 2px; }
  .ticket-bars i:nth-child(3n) { width: 3px; }
  .ticket-wrap figcaption {
    max-width: 34ch;
    text-align: center;
  }
  /* The amber tag is this screen's one accent: it marks the ticket as a sample */
  .ticket-wrap b {
    margin-right: 6px;
    padding: 2px 8px;
    color: var(--on-amber);
    background: var(--amber);
    border-radius: var(--radius-s);
    font-size: 0.8rem;
  }

  /* Two apps, as text */
  .apps dl {
    display: grid;
    gap: 0;
  }
  .apps dl > div {
    padding-block: 22px;
    border-top: 1px solid var(--line-strong);
  }
  .apps dl > div:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .apps dt {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .apps dd {
    margin-top: 6px;
    color: var(--muted);
  }

  /* Real screenshots: three phones, the middle one in front */
  .screens {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .screens :global(.screen) {
    flex: none;
    width: 30%;
    max-width: 250px;
    height: auto;
    filter: drop-shadow(0 18px 22px rgba(22, 21, 27, 0.28));
  }
  .screens :global(.screen + .screen) {
    margin-left: -4%;
  }
  .screens :global(.screen-1) {
    transform: translateY(5%) rotate(-5deg);
  }
  .screens :global(.screen-2) {
    position: relative;
    z-index: 2;
    width: 34%;
    max-width: 280px;
    transform: translateY(-2%);
  }
  .screens :global(.screen-3) {
    transform: translateY(5%) rotate(5deg);
  }
</style>
