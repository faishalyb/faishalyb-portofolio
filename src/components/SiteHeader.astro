---
import Icon from './Icon.astro';
import { profile } from '../data/site';

// Every item points at a section that exists on the home page.
const isHome = Astro.url.pathname === '/';
const nav = [
  { label: 'Work', id: 'work' },
  { label: 'Face check', id: 'face-check' },
  { label: 'Experience', id: 'experience' },
  { label: 'Writing', id: 'writing' },
].map((item) => ({ ...item, href: `${isHome ? '' : '/'}#${item.id}` }));
const contactHref = `${isHome ? '' : '/'}#contact`;
---

<header class="site-header" data-header>
  <div class="bar shell">
    <a class="wordmark" href="/" aria-label={`${profile.name}, home`}>{profile.name}</a>

    <nav class="nav-desktop" aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Use dark theme">
        <span class="when-light"><Icon name="moon" size={20} /></span>
        <span class="when-dark"><Icon name="sun" size={20} /></span>
      </button>
      <!-- Sticky call to action (MASTER.md pattern: CTA in the hero, kept in the header) -->
      <a class="btn btn-primary btn-sm header-cta" href={contactHref}>Contact <Icon name="arrow-right" size={18} /></a>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-panel" aria-label="Open menu">
        <span class="when-closed"><Icon name="menu" /></span>
        <span class="when-open"><Icon name="close" /></span>
      </button>
    </div>
  </div>

  <nav class="menu-panel" id="menu-panel" aria-label="Main, mobile" data-menu-panel hidden>
    <ul class="shell">
      {nav.map((item) => (
        <li><a class="menu-link" href={item.href}>{item.label}<Icon name="next" size={20} /></a></li>
      ))}
      <li class="menu-actions">
        <a class="btn btn-primary" href={contactHref}>Contact me</a>
        <a class="btn btn-secondary" href={profile.resume} target="_blank" rel="noopener">Résumé (PDF) <Icon name="download" size={18} /></a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  // Theme: follows the system until the visitor picks one; the choice is remembered.
  const syncThemeLabel = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    themeBtn?.setAttribute('aria-label', dark ? 'Use light theme' : 'Use dark theme');
  };
  syncThemeLabel();
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* Storage can be blocked; the theme still switches for this visit. */
    }
    syncThemeLabel();
  });

  // A shadow appears under the header once the page scrolls.
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu: a disclosure. Escape, a link click or a wide screen closes it.
  const setMenu = (open: boolean) => {
    if (!menuBtn || !panel || !header) return;
    panel.hidden = !open;
    header.classList.toggle('menu-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  menuBtn?.addEventListener('click', () => setMenu(panel?.hidden ?? false));
  panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel && !panel.hidden) {
      setMenu(false);
      menuBtn?.focus();
    }
  });
  matchMedia('(min-width: 960px)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    border-bottom: 1px solid transparent;
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    transition:
      border-color var(--duration) ease,
      box-shadow var(--duration) ease;
  }
  .site-header.is-scrolled,
  .site-header.menu-open {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--header);
  }
  /* Name only, no logo mark */
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-right: auto;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color var(--duration) ease;
  }
  .wordmark:hover {
    color: var(--color-primary);
  }
  .nav-desktop {
    display: none;
    gap: 2px;
  }
  .nav-desktop a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 14px;
    color: var(--color-muted-foreground);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: 500;
    transition:
      color var(--duration) ease,
      background-color var(--duration) ease;
  }
  .nav-desktop a:hover {
    color: var(--color-foreground);
    background: var(--color-primary-soft);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .header-cta {
    display: none;
  }
  .icon-btn {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    color: var(--color-foreground);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease;
  }
  .icon-btn:hover {
    background: var(--color-primary-soft);
    border-color: var(--color-primary);
  }
  .when-dark,
  .when-open {
    display: none;
  }
  :global([data-theme='dark']) .when-light {
    display: none;
  }
  :global([data-theme='dark']) .when-dark {
    display: block;
  }
  .menu-open .when-closed {
    display: none;
  }
  .menu-open .when-open {
    display: block;
  }

  .menu-panel ul {
    display: grid;
    gap: 4px;
    padding-block: 8px 24px;
  }
  .menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding-inline: 16px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    transition: background-color var(--duration) ease;
  }
  .menu-link:hover {
    background: var(--color-primary-soft);
  }
  .menu-link :global(.icon) {
    color: var(--color-primary);
  }
  .menu-actions {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }

  @media (min-width: 600px) {
    .header-cta {
      display: inline-flex;
    }
  }
  @media (min-width: 960px) {
    .nav-desktop {
      display: flex;
    }
    .menu-btn,
    .menu-panel {
      display: none;
    }
  }
</style>
